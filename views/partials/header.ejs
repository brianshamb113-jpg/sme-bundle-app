<!DOCTYPE html>
<html lang="<%= typeof lang !== 'undefined' && lang === 'sw' ? 'sw' : 'en' %>">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0, maximum-scale=5.0, user-scalable=yes">
    <title>SME Bundles TZ</title>
    <link rel="manifest" href="/manifest.json">
    <meta name="theme-color" content="#1a237e">
    <meta name="apple-mobile-web-app-capable" content="yes">
    <link rel="icon" type="image/png" sizes="192x192" href="/images/icon-192.png">
    <link rel="icon" type="image/png" sizes="512x512" href="/images/icon-512.png">
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700;800&display=swap" rel="stylesheet">
    <script src="https://cdn.tailwindcss.com"></script>
    <style>
        * { font-family: 'Inter', sans-serif; }
        .glass {
            background: rgba(255, 255, 255, 0.05);
            backdrop-filter: blur(12px);
            border: 1px solid rgba(255, 255, 255, 0.12);
        }
        .gradient-text {
            background: linear-gradient(135deg, #60a5fa, #a78bfa, #f472b6);
            -webkit-background-clip: text;
            background-clip: text;
            -webkit-text-fill-color: transparent;
        }
        .glow { box-shadow: 0 0 40px rgba(96, 165, 250, 0.15); }
        .glow:hover { box-shadow: 0 0 60px rgba(96, 165, 250, 0.3); }
        .animated-bg {
            background: linear-gradient(-45deg, #0a0a1a, #1a1a3e, #0d1b2a, #1a0a2e);
            background-size: 400% 400%;
            animation: gradient 15s ease infinite;
            min-height: 100vh;
        }
        @keyframes gradient {
            0% { background-position: 0% 50%; }
            50% { background-position: 100% 50%; }
            100% { background-position: 0% 50%; }
        }
        .theme-toggle { cursor: pointer; transition: all 0.3s; }
        .theme-toggle:hover { transform: scale(1.1); }
        body.light-theme .animated-bg {
            background: linear-gradient(-45deg, #f0f4ff, #e8eeff, #f5f0ff, #f0f4ff);
        }
        body.light-theme .glass {
            background: rgba(255, 255, 255, 0.7);
            border: 1px solid rgba(0, 0, 0, 0.08);
        }
        body.light-theme .text-white { color: #1a1a2e !important; }
        body.light-theme .text-gray-400 { color: #666 !important; }
        body.light-theme .text-gray-300 { color: #444 !important; }
        /* Mobile responsive fixes */
@media (max-width: 640px) {
    body {
        font-size: 14px;
    }
    .glass {
        border-radius: 12px;
    }
    /* Prevent horizontal scroll */
    html, body {
        overflow-x: hidden;
        max-width: 100vw;
    }
    /* Ensure container fits */
    .max-w-6xl, .max-w-4xl, .max-w-3xl, .max-w-2xl, .max-w-md {
        max-width: 100% !important;
        padding-left: 12px !important;
        padding-right: 12px !important;
    }
}
    </style>
</head>
<body class="bg-gray-50 w-full overflow-x-hidden">
    <div class="animated-bg w-full min-h-screen">
        <nav class="glass sticky top-0 z-50 px-3 py-2">
    <div class="max-w-6xl mx-auto flex justify-between items-center gap-2">
        <!-- Brand -->
        <a href="/" class="flex items-center space-x-1 flex-shrink-0">
            <span class="text-xl">📱</span>
            <span class="text-sm font-bold text-white hidden sm:inline">SME Bundles TZ</span>
        </a>

        <!-- Menu -->
        <div class="flex items-center gap-1 sm:gap-3">
            <!-- Language -->
            <a href="#" onclick="toggleLanguage(); return false;" class="text-xs sm:text-sm text-white/80 hover:text-white transition whitespace-nowrap">
                <%= lang === 'sw' ? '🇬🇧 EN' : '🇹🇿 SW' %>
            </a>

            <!-- Theme Toggle -->
            <button onclick="toggleTheme()" class="theme-toggle text-lg sm:text-xl" id="themeIcon">🌙</button>

            <% if (typeof user !== 'undefined' && user) { %>
                <!-- Dashboard (icon only on mobile) -->
                <a href="/dashboard" class="text-white/80 hover:text-white transition text-xs sm:text-sm whitespace-nowrap">
                    <span class="hidden sm:inline"><%= lang === 'sw' ? 'Dashibodi' : 'Dashboard' %></span>
                    <span class="sm:hidden">🏠</span>
                </a>

                <!-- Settings (icon only on mobile) -->
                <a href="/settings" class="text-white/80 hover:text-white transition text-xs sm:text-sm whitespace-nowrap">
                    <span class="hidden sm:inline">⚙️ <%= lang === 'sw' ? 'Mipangilio' : 'Settings' %></span>
                    <span class="sm:hidden">⚙️</span>
                </a>

                <!-- Logout -->
                <a href="/logout" class="px-2 sm:px-4 py-1.5 sm:py-2 bg-gradient-to-r from-blue-500 to-purple-600 rounded-full text-white text-xs sm:text-sm font-semibold whitespace-nowrap">
                    <%= lang === 'sw' ? 'Toka' : 'Exit' %>
                </a>
            <% } else { %>
                <a href="/login" class="text-xs sm:text-sm text-white/80 hover:text-white transition whitespace-nowrap">
                    <%= lang === 'sw' ? 'Ingia' : 'Login' %>
                </a>
                <a href="/register" class="px-2 sm:px-4 py-1.5 sm:py-2 bg-gradient-to-r from-blue-500 to-purple-600 rounded-full text-white text-xs sm:text-sm font-semibold whitespace-nowrap">
                    <%= lang === 'sw' ? 'Jisajili' : 'Sign Up' %>
                </a>
            <% } %>
        </div>
    </div>
</nav>