<!DOCTYPE html>
<html lang="<%= typeof lang !== 'undefined' && lang === 'sw' ? 'sw' : 'en' %>">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>SME Bundles TZ</title>
    <link rel="manifest" href="/manifest.json">
    <meta name="theme-color" content="#1a237e">
    <meta name="apple-mobile-web-app-capable" content="yes">
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700;800&display=swap" rel="stylesheet">
    <script src="https://cdn.tailwindcss.com"></script>
    <style>
        * { font-family: 'Inter', sans-serif; }
        .glass {
            background: rgba(255, 255, 255, 0.05);
            backdrop-filter: blur(12px);
            border: 1px solid rgba(255, 255, 255, 0.12);
        }
        .gradient-text {
            background: linear-gradient(135deg, #60a5fa, #a78bfa, #f472b6);
            -webkit-background-clip: text;
            background-clip: text;
            -webkit-text-fill-color: transparent;
        }
        .glow { box-shadow: 0 0 40px rgba(96, 165, 250, 0.15); }
        .glow:hover { box-shadow: 0 0 60px rgba(96, 165, 250, 0.3); }
        .animated-bg {
            background: linear-gradient(-45deg, #0a0a1a, #1a1a3e, #0d1b2a, #1a0a2e);
            background-size: 400% 400%;
            animation: gradient 15s ease infinite;
            min-height: 100vh;
        }
        @keyframes gradient {
            0% { background-position: 0% 50%; }
            50% { background-position: 100% 50%; }
            100% { background-position: 0% 50%; }
        }
        .theme-toggle { cursor: pointer; transition: all 0.3s; }
        .theme-toggle:hover { transform: scale(1.1); }
        body.light-theme .animated-bg {
            background: linear-gradient(-45deg, #f0f4ff, #e8eeff, #f5f0ff, #f0f4ff);
        }
        body.light-theme .glass {
            background: rgba(255, 255, 255, 0.7);
            border: 1px solid rgba(0, 0, 0, 0.08);
        }
        body.light-theme .text-white { color: #1a1a2e !important; }
        body.light-theme .text-gray-400 { color: #666 !important; }
        body.light-theme .text-gray-300 { color: #444 !important; }
    </style>
</head>
<body>
    <div class="animated-bg">
        <nav class="glass sticky top-0 z-50 px-4 py-3">
            <div class="max-w-6xl mx-auto flex justify-between items-center">
                <a href="/" class="flex items-center space-x-2">
                    <span class="text-2xl">📱</span>
                    <span class="text-xl font-bold text-white">SME Bundles TZ</span>
                </a>
                <div class="flex items-center space-x-4">
                    <a href="#" onclick="toggleLanguage(); return false;" class="text-sm text-white/80 hover:text-white transition">
                        <%= lang === 'sw' ? '🇬🇧 English' : '🇹🇿 Kiswahili' %>
                    </a>
                    <button onclick="toggleTheme()" class="theme-toggle text-2xl" id="themeIcon">🌙</button>
                    <% if (typeof user !== 'undefined' && user) { %>
                        <a href="/dashboard" class="text-white/80 hover:text-white transition text-sm">
                            <%= lang === 'sw' ? 'Dashibodi' : 'Dashboard' %>
                        </a>
                        <a href="/settings" class="text-white/80 hover:text-white transition text-sm">
                            ⚙️ <%= lang === 'sw' ? 'Mipangilio' : 'Settings' %>
                        </a>
                        <a href="/logout" class="px-4 py-2 bg-gradient-to-r from-blue-500 to-purple-600 rounded-full text-white text-sm font-semibold hover:scale-105 transition">
                            <%= lang === 'sw' ? 'Toka' : 'Logout' %>
                        </a>
                    <% } else { %>
                        <a href="/login" class="text-white/80 hover:text-white transition text-sm">
                            <%= lang === 'sw' ? 'Ingia' : 'Login' %>
                        </a>
                        <a href="/register" class="px-4 py-2 bg-gradient-to-r from-blue-500 to-purple-600 rounded-full text-white text-sm font-semibold hover:scale-105 transition">
                            <%= lang === 'sw' ? 'Jisajili' : 'Register' %>
                        </a>
                    <% } %>
                </div>
            </div>
        </nav>