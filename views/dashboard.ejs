<%- include('partials/header') %>

<div class="max-w-6xl mx-auto px-4 py-8">
    <!-- Welcome -->
    <div class="glass rounded-2xl p-6 mb-6">
        <div class="flex justify-between items-center flex-wrap gap-4">
            <div>
                <h2 class="text-2xl font-bold text-white">
                    👋 <%= lang === 'sw' ? 'Karibu' : 'Welcome' %>, <span class="gradient-text"><%= user.fullname %></span>!
                </h2>
                <p class="text-gray-400 text-sm mt-1">
                    <%= lang === 'sw' ? 'Nunua SME bundles papara na upate utumaji wa moja kwa moja.' : 'Buy SME bundles instantly and get automatic delivery.' %>
                </p>
            </div>
            <div class="text-right">
                <div class="text-sm text-gray-400"><%= lang === 'sw' ? 'Simu' : 'Phone' %></div>
                <div class="text-white font-semibold"><%= user.phone %></div>
            </div>
        </div>    
    </div>
    <!-- Announcements -->
<% if (typeof announcements !== 'undefined' && announcements.length > 0) { %>
    <% announcements.forEach(function(a) { %>
        <div class="glass rounded-2xl p-5 mb-4 border-l-4 <%= a.type === 'success' ? 'border-green-500' : a.type === 'warning' ? 'border-yellow-500' : 'border-blue-500' %>">
            <div class="flex items-start gap-3">
                <span class="text-2xl">
                    <%= a.type === 'success' ? '✅' : a.type === 'warning' ? '⚠️' : '📢' %>
                </span>
                <div class="flex-1">
                    <div class="font-bold text-white"><%= a.title %></div>
                    <p class="text-gray-300 text-sm mt-1"><%= a.message %></p>
                </div>
            </div>
        </div>
    <% }); %>
<% } %>
<!-- Bonus Unlock Notification -->
<% if (typeof bonusStatus !== 'undefined' && bonusStatus.unlocked && !bonusStatus.alreadySent) { %>
    <div class="glass rounded-2xl p-5 mb-6 border-2 border-yellow-500/50 bg-gradient-to-r from-yellow-500/10 to-orange-500/10">
        <div class="flex items-start gap-3">
            <span class="text-3xl">🎁</span>
            <div class="flex-1">
                <div class="font-bold text-yellow-300 text-lg">
                    <%= lang === 'sw' ? 'Hongera! Bonasi Yako Imefunguliwa!' : 'Congratulations! Your Bonus is Unlocked!' %>
                </div>
                <p class="text-gray-200 text-sm mt-2">
                    <%= lang === 'sw' 
                        ? 'Umefanya manunuzi ' + bonusStatus.count + ' wiki hii! Utapokea bonasi ya 2GB hivi karibuni. Admin atatuma bundle yako ndani ya saa 24.'
                        : 'You made ' + bonusStatus.count + ' purchases this week! You\'ll receive a 2GB bonus soon. Admin will send your bundle within 24 hours.'
                    %>
                </p>
            </div>
        </div>
    </div>
<% } %>

    <!-- Quick Actions -->
    <div class="grid grid-cols-2 sm:grid-cols-4 gap-3 mb-6">
        <a href="/settings" class="glass rounded-xl p-4 text-center hover:bg-white/10 transition">
            <div class="text-2xl mb-1">⚙️</div>
            <div class="text-xs font-semibold text-white"><%= lang === 'sw' ? 'Mipangilio' : 'Settings' %></div>
        </a>
        <a href="/transactions" class="glass rounded-xl p-4 text-center hover:bg-white/10 transition">
            <div class="text-2xl mb-1">📊</div>
            <div class="text-xs font-semibold text-white"><%= lang === 'sw' ? 'Historia' : 'History' %></div>
        </a>
    </div>
    
    <!-- Referral Card -->
<% if (typeof referralStats !== 'undefined' && referralStats.code) { %>
    <div class="glass rounded-2xl p-6 mb-6 border-2 border-purple-500/30">
        <div class="flex items-start gap-4 flex-wrap">
            <div class="text-4xl">🎁</div>
            <div class="flex-1 min-w-[250px]">
                <h3 class="text-lg font-bold text-white">
                    <%= lang === 'sw' ? 'Alika Marafiki, Pata 100MB' : 'Invite Friends, Earn 100MB' %>
                </h3>
                <p class="text-gray-400 text-sm mt-1">
                    <%= lang === 'sw' 
                        ? 'Ukialika mtu na akinunua bundle, wote wawili mtapata 100MB bure!' 
                        : 'Invite someone and when they buy a bundle, BOTH of you get 100MB free!' %>
                </p>

                <div class="flex items-center gap-3 mt-4 flex-wrap">
                    <div class="flex items-center gap-2 bg-white/5 border border-white/10 rounded-xl px-4 py-2">
                        <span class="text-xs text-gray-400"><%= lang === 'sw' ? 'Kodi yako:' : 'Your code:' %></span>
                        <span class="font-mono font-bold text-purple-300" id="referralCode"><%= referralStats.code %></span>
                    </div>
                    <button onclick="copyReferralCode()" class="px-4 py-2 bg-gradient-to-r from-purple-500 to-pink-500 rounded-xl text-white text-sm font-semibold hover:scale-105 transition">
                        📋 <%= lang === 'sw' ? 'Nakili' : 'Copy' %>
                    </button>
                    <a href="https://wa.me/?text=<%= encodeURIComponent((lang === 'sw' ? 'Jiunge na SME Bundles TZ na ununue bundles kwa punguzo! Tumia kodi yangu ' : 'Join SME Bundles TZ and buy bundles at a discount! Use my code ') + referralStats.code + ' - https://sme-bundle-app.onrender.com/register?ref=' + referralStats.code) %>" 
                       target="_blank"
                       class="px-4 py-2 bg-gradient-to-r from-green-500 to-green-600 rounded-xl text-white text-sm font-semibold hover:scale-105 transition">
                        📱 <%= lang === 'sw' ? 'Shiriki WhatsApp' : 'Share on WhatsApp' %>
                    </a>
                </div>

                <div class="grid grid-cols-2 gap-3 mt-4">
                    <div class="bg-white/5 rounded-xl p-3 text-center">
                        <div class="text-2xl font-bold text-blue-400"><%= referralStats.count %></div>
                        <div class="text-xs text-gray-400"><%= lang === 'sw' ? 'Walioalikwa' : 'Friends Invited' %></div>
                    </div>
                    <div class="bg-white/5 rounded-xl p-3 text-center">
                        <div class="text-2xl font-bold text-green-400"><%= referralStats.rewards * 100 %>MB</div>
                        <div class="text-xs text-gray-400"><%= lang === 'sw' ? 'MB Uliyopata' : 'MB Earned' %></div>
                    </div>
                </div>
            </div>
        </div>
    </div>

    <script>
    function copyReferralCode() {
        const code = document.getElementById('referralCode').textContent;
        navigator.clipboard.writeText(code).then(function() {
            alert('<%= lang === "sw" ? "Kodi imenakiliwa!" : "Code copied!" %>');
        });
    }
    </script>
<% } %>

    <!-- Bundles -->
    <h2 class="text-2xl font-bold text-white mb-6">
        🔥 <%= lang === 'sw' ? 'Bundles Zilizopo' : 'Available Bundles' %>
    </h2>
   <div class="grid grid-cols-2 sm:grid-cols-3 md:grid-cols-4 lg:grid-cols-5 gap-3">
        <% bundles.forEach(function(bundle) { %>
            <div class="glass rounded-2xl p-5 text-center hover:scale-105 transition hover:glow">
                <div class="text-3xl mb-2">
                    <%= bundle.data === '1GB' ? '📱' : bundle.data === '2GB' ? '📶' : bundle.data === '5GB' ? '🚀' : '⚡' %>
                </div>
                <h3 class="text-base font-bold text-white"><%= bundle.name %></h3>
                <div class="text-2xl font-bold text-blue-400 my-2">TZS <%= bundle.price.toLocaleString() %></div>
                <div class="text-xs text-gray-400 line-through">TZS <%= bundle.originalPrice.toLocaleString() %></div>
                <div class="text-green-400 font-semibold text-xs mt-1">
                    💚 <%= lang === 'sw' ? 'Okoa' : 'Save' %> <%= (bundle.originalPrice - bundle.price).toLocaleString() %>
                </div>
                <form action="/buy" method="POST" class="mt-4">
                    <input type="hidden" name="bundleId" value="<%= bundle.id %>">
                    <button type="submit" class="w-full py-2 bg-gradient-to-r from-blue-500 to-purple-600 rounded-full font-semibold text-white text-sm hover:scale-105 transition">
                        <%= lang === 'sw' ? 'Nunua' : 'Buy Now' %>
                    </button>
                </form>
            </div>
        <% }); %>
    </div>

    <!-- Recent Transactions -->
    <% if (transactions && transactions.length > 0) { %>
        <div class="glass rounded-2xl p-6 mt-6">
            <h3 class="text-xl font-bold text-white mb-4">
                📋 <%= lang === 'sw' ? 'Manunuzi ya Hivi Karibuni' : 'Recent Purchases' %>
            </h3>
            <% for (var i = 0; i < Math.min(transactions.length, 5); i++) { %>
                <div class="border-b border-white/10 py-3 flex justify-between items-center">
                    <div>
                        <strong class="text-white"><%= transactions[i].bundleName %></strong>
                        <div class="text-sm text-gray-400"><%= new Date(transactions[i].date).toLocaleDateString('en-TZ') %></div>
                    </div>
                    <div>
                        <span class="font-bold text-green-400">TZS <%= transactions[i].amount.toLocaleString() %></span>
                        <span class="ml-2 text-green-400">✅</span>
                    </div>
                </div>
            <% } %>
            <a href="/transactions" class="inline-block mt-4 text-blue-400 font-semibold hover:text-blue-300 transition">
                <%= lang === 'sw' ? 'Tazama Zote →' : 'View All →' %>
            </a>
        </div>
    <% } %>
</div>

<%- include('partials/footer') %>