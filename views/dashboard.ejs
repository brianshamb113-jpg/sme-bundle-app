<!DOCTYPE html>
<html lang="<%= lang === 'sw' ? 'sw' : 'en' %>">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title><%= lang === 'sw' ? 'Dashibodi' : 'Dashboard' %> - SME Bundles</title>
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700;800&display=swap" rel="stylesheet">
    <script src="https://cdn.tailwindcss.com"></script>
    <script>
    // Language toggle via fetch (no page reload needed)
    function toggleLanguage() {
        fetch('/toggle-language')
            .then(response => {
                // After toggling, reload the page to show the new language
                window.location.reload();
            })
            .catch(error => {
                console.error('Language toggle failed:', error);
                // Fallback: just reload the page
                window.location.reload();
            });
    }
</script>
    <style>
        * { font-family: 'Inter', sans-serif; }
        .glass {
            background: rgba(255, 255, 255, 0.05);
            backdrop-filter: blur(12px);
            border: 1px solid rgba(255, 255, 255, 0.12);
        }
        .gradient-text {
            background: linear-gradient(135deg, #60a5fa, #a78bfa, #f472b6);
            -webkit-background-clip: text;
            background-clip: text;
            -webkit-text-fill-color: transparent;
        }
        .glow {
            box-shadow: 0 0 40px rgba(96, 165, 250, 0.15);
        }
        .glow:hover {
            box-shadow: 0 0 60px rgba(96, 165, 250, 0.3);
        }
        .animated-bg {
            background: linear-gradient(-45deg, #0a0a1a, #1a1a3e, #0d1b2a, #1a0a2e);
            background-size: 400% 400%;
            animation: gradient 15s ease infinite;
            min-height: 100vh;
        }
        @keyframes gradient {
            0% { background-position: 0% 50%; }
            50% { background-position: 100% 50%; }
            100% { background-position: 0% 50%; }
        }
        @keyframes reveal {
            to { opacity: 1; transform: translateY(0); }
        }
        .reveal {
            opacity: 0;
            transform: translateY(30px);
            animation: reveal 0.8s cubic-bezier(0.2, 0, 0, 1) forwards;
        }
        .theme-toggle {
            cursor: pointer;
            transition: all 0.3s;
        }
        .theme-toggle:hover {
            transform: scale(1.1);
        }
        body.light-theme .animated-bg {
            background: linear-gradient(-45deg, #f0f4ff, #e8eeff, #f5f0ff, #f0f4ff);
            background-size: 400% 400%;
            animation: gradient 15s ease infinite;
        }
        body.light-theme .glass {
            background: rgba(255, 255, 255, 0.7);
            border: 1px solid rgba(0, 0, 0, 0.08);
        }
        body.light-theme .text-white {
            color: #1a1a2e !important;
        }
        body.light-theme .text-gray-400 {
            color: #666 !important;
        }
        body.light-theme .text-gray-300 {
            color: #444 !important;
        }
        body.light-theme .border-white\/10 {
            border-color: #ddd !important;
        }
    </style>
</head>
<body>
    <div class="animated-bg">
        <!-- Navigation -->
        <nav class="glass sticky top-0 z-50 px-4 py-3">
            <div class="flex items-center space-x-4">
    <!-- LANGUAGE TOGGLE - Fixed version -->
    <a href="#" onclick="toggleLanguage(); return false;" class="text-sm text-white/80 hover:text-white transition">
        <%= locals.lang === 'sw' ? '🇬🇧 English' : '🇹🇿 Kiswahili' %>
    </a>
    <button onclick="toggleTheme()" class="theme-toggle text-2xl" id="themeIcon">🌙</button>
    <a href="/transactions" class="text-white/80 hover:text-white transition text-sm">
        <%= locals.lang === 'sw' ? 'Historia' : 'History' %>
    </a>
    <a href="/logout" class="px-4 py-2 bg-gradient-to-r from-blue-500 to-purple-600 rounded-full text-white text-sm font-semibold hover:scale-105 transition">
        <%= locals.lang === 'sw' ? 'Toka' : 'Logout' %>
    </a>
</div>
        </nav>

        <div class="max-w-6xl mx-auto px-4 py-8">
            <!-- Welcome Section -->
            <div class="glass rounded-2xl p-6 mb-8 reveal">
                <div class="flex justify-between items-center flex-wrap gap-4">
                    <div>
                        <h2 class="text-2xl font-bold text-white">
                            <%= lang === 'sw' ? '👋 Karibu' : '👋 Welcome' %>, <span class="gradient-text"><%= user.fullname %></span>!
                        </h2>
                        <p class="text-gray-400 text-sm mt-1">
                            <%= lang === 'sw' ? 'Nunua SME bundles papara na upate utumaji wa moja kwa moja.' : 'Buy SME bundles instantly and get automatic delivery.' %>
                        </p>
                    </div>
                    <div class="text-right">
                        <div class="text-sm text-gray-400"><%= lang === 'sw' ? 'Simu' : 'Phone' %></div>
                        <div class="text-white font-semibold"><%= user.phone %></div>
                    </div>
                </div>

                <% if (bonusEligible) { %>
                    <div class="mt-4 bg-green-500/20 border border-green-500/30 text-green-300 p-4 rounded-xl">
                        <strong>🎉 <%= bonusMessage %></strong>
                    </div>
                <% } else { %>
                    <div class="mt-4 bg-yellow-500/20 border border-yellow-500/30 text-yellow-300 p-4 rounded-xl">
                        <strong>💪 <%= bonusMessage %></strong>
                    </div>
                <% } %>
            </div>
            <!-- Quick Actions -->
<div class="grid grid-cols-2 gap-3 mb-6">
    <a href="/settings" class="glass rounded-xl p-4 text-center hover:bg-white/10 transition">
        <div class="text-2xl mb-1">⚙️</div>
        <div class="text-xs font-semibold text-white">
            <%= lang === 'sw' ? 'Mipangilio' : 'Settings' %>
        </div>
    </a>
    <a href="/transactions" class="glass rounded-xl p-4 text-center hover:bg-white/10 transition">
        <div class="text-2xl mb-1">📊</div>
        <div class="text-xs font-semibold text-white">
            <%= lang === 'sw' ? 'Historia' : 'History' %>
        </div>
    </a>
</div>

            <!-- Bundles Section -->
<section id="bundles" class="relative py-20 px-4">
    <div class="max-w-6xl mx-auto">
        <h2 class="text-3xl md:text-4xl font-bold text-center mb-4">
            🔥 <span class="gradient-text">Available Bundles</span>
        </h2>
        <p class="text-gray-400 text-center mb-12">Choose your bundle and get instant delivery</p>

        <div class="grid grid-cols-1 md:grid-cols-3 gap-6" id="bundleContainer">
            <% bundles.forEach((bundle, index) => { %>
                <div class="glass rounded-2xl p-8 text-center hover:scale-105 transition duration-300 hover:glow bundle-card" data-delay="<%= index * 0.15 %>">
                    <div class="text-4xl mb-4">
                        <%= bundle.data === '1GB' ? '📱' : bundle.data === '2GB' ? '📶' : '🚀' %>
                    </div>
                    <h3 class="text-xl font-bold text-white"><%= bundle.name %></h3>
                    <div class="text-4xl font-bold text-blue-400 my-4">
                        TZS <%= bundle.price.toLocaleString() %>
                    </div>
                    <div class="text-sm text-gray-400 line-through">
                        Original: TZS <%= bundle.originalPrice.toLocaleString() %>
                    </div>
                    <div class="text-green-400 font-semibold mt-2">
                        💚 Save TZS <%= (bundle.originalPrice - bundle.price).toLocaleString() %>
                    </div>
                    <% if (user) { %>
                        <form action="/buy" method="POST" class="mt-6">
                            <input type="hidden" name="bundleId" value="<%= bundle.id %>">
                            <button type="submit" class="w-full py-3 bg-gradient-to-r from-blue-500 to-purple-600 rounded-full font-semibold text-white hover:scale-105 transition duration-300">
                                Buy Now
                            </button>
                        </form>
                    <% } else { %>
                        <a href="/register" class="block w-full py-3 bg-gradient-to-r from-blue-500 to-purple-600 rounded-full font-semibold text-white hover:scale-105 transition duration-300 text-center">
                            Buy Now
                        </a>
                    <% } %>
                </div>
            <% }); %>
        </div>
    </div>
</section>
            <!-- Recent Transactions -->
            <% if (transactions && transactions.length > 0) { %>
                <div class="glass rounded-2xl p-6 mt-8 reveal">
                    <h3 class="text-xl font-bold text-white mb-4">
                        📋 <%= lang === 'sw' ? 'Manunuzi ya Hivi Karibuni' : 'Recent Purchases' %>
                    </h3>
                    <% for (var i = 0; i < Math.min(transactions.length, 5); i++) { %>
                        <div class="border-b border-white/10 py-3 flex justify-between items-center">
                            <div>
                                <strong class="text-white"><%= transactions[i].bundleName %></strong>
                                <div class="text-sm text-gray-400"><%= new Date(transactions[i].date).toLocaleDateString('en-TZ') %></div>
                            </div>
                            <div>
                                <span class="font-bold text-green-400">TZS <%= transactions[i].amount.toLocaleString() %></span>
                                <span class="ml-2 text-green-400">✅</span>
                            </div>
                        </div>
                    <% } %>
                    <a href="/transactions" class="inline-block mt-4 text-blue-400 font-semibold hover:text-blue-300 transition">
                        <%= lang === 'sw' ? 'Tazama Zote →' : 'View All →' %>
                    </a>
                </div>
            <% } %>

            <!-- Features -->
            <div class="grid grid-cols-2 md:grid-cols-4 gap-4 mt-8">
                <div class="glass rounded-xl p-4 text-center reveal" style="animation-delay: 0.1s;">
                    <div class="text-3xl">⚡</div>
                    <h4 class="font-bold text-white text-sm mt-2"><%= lang === 'sw' ? 'Papara' : 'Instant' %></h4>
                    <p class="text-xs text-gray-400"><%= lang === 'sw' ? 'Utumaji wa haraka' : 'Fast delivery' %></p>
                </div>
                <div class="glass rounded-xl p-4 text-center reveal" style="animation-delay: 0.2s;">
                    <div class="text-3xl">💰</div>
                    <h4 class="font-bold text-white text-sm mt-2"><%= lang === 'sw' ? 'Bei Nzuri' : 'Best Price' %></h4>
                    <p class="text-xs text-gray-400"><%= lang === 'sw' ? 'Okoa hadi 50%' : 'Save up to 50%' %></p>
                </div>
                <div class="glass rounded-xl p-4 text-center reveal" style="animation-delay: 0.3s;">
                    <div class="text-3xl">🏆</div>
                    <h4 class="font-bold text-white text-sm mt-2"><%= lang === 'sw' ? 'Zawadi' : 'Rewards' %></h4>
                    <p class="text-xs text-gray-400"><%= lang === 'sw' ? 'Bonasi 2000 TZS kila wiki' : '2000 TZS weekly bonus' %></p>
                </div>
                <div class="glass rounded-xl p-4 text-center reveal" style="animation-delay: 0.4s;">
                    <div class="text-3xl">🛡️</div>
                    <h4 class="font-bold text-white text-sm mt-2"><%= lang === 'sw' ? 'Salama' : 'Secure' %></h4>
                    <p class="text-xs text-gray-400"><%= lang === 'sw' ? 'Manunuzi salama' : 'Safe transactions' %></p>
                </div>
            </div>
        </div>

        <footer class="text-center text-gray-400 text-sm py-6">
            <p>&copy; 2026 SME Bundles Tanzania. <%= lang === 'sw' ? 'Imetengenezwa kwa ❤️ Tanzania' : 'Made with ❤️ in Tanzania' %> 🇹🇿</p>
        </footer>
    </div>

    <script>
        // Theme toggle (dark/light)
        let isDark = true;

        function toggleTheme() {
            isDark = !isDark;
            const body = document.body;
            const icon = document.getElementById('themeIcon');

            if (isDark) {
                body.classList.remove('light-theme');
                icon.textContent = '🌙';
            } else {
                body.classList.add('light-theme');
                icon.textContent = '☀️';
            }
        }
    </script>
    <script>
    function toggleLanguage() {
        fetch('/toggle-language')
            .then(response => {
                if (response.redirected) {
                    window.location.href = response.url;
                } else {
                    window.location.reload();
                }
            })
            .catch(() => {
                window.location.reload();
            });
    }
</script>
</body>
</html>