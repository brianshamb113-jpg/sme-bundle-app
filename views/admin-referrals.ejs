<%- include('partials/header') %>

<div class="max-w-6xl mx-auto px-4 py-8">
    <div class="flex justify-between items-center mb-6 flex-wrap gap-3">
        <h1 class="text-2xl font-bold text-white">🎁 <%= lang === 'sw' ? 'Usimamizi wa Rufaa' : 'Referral Management' %></h1>
        <a href="/admin" class="text-sm text-gray-400 hover:text-white transition">
            ← <%= lang === 'sw' ? 'Rudi Admin' : 'Back to Admin' %>
        </a>
    </div>

    <div class="glass rounded-2xl p-5 mb-6">
        <div class="text-center">
            <div class="text-4xl font-bold text-purple-400"><%= totalReferrals %></div>
            <div class="text-sm text-gray-400"><%= lang === 'sw' ? 'Rufaa Zote' : 'Total Referrals' %></div>
        </div>
    </div>

    <!-- Top Referrers -->
    <div class="glass rounded-2xl p-6 mb-6">
        <h2 class="text-xl font-bold text-white mb-4">🏆 <%= lang === 'sw' ? 'Wanaoongoza' : 'Top Referrers' %></h2>
        <% if (topReferrers.length === 0) { %>
            <p class="text-gray-400 text-center py-6 text-sm">
                <%= lang === 'sw' ? 'Hakuna rufaa bado' : 'No referrals yet' %>
            </p>
        <% } else { %>
            <div class="space-y-2">
                <% topReferrers.forEach(function(u, i) { %>
                    <div class="flex items-center justify-between p-3 bg-white/5 rounded-xl">
                        <div class="flex items-center gap-3">
                            <div class="w-8 h-8 rounded-full bg-gradient-to-r from-purple-500 to-pink-500 flex items-center justify-center text-white font-bold text-sm">
                                <%= i + 1 %>
                            </div>
                            <div>
                                <div class="text-white font-semibold"><%= u.fullname %></div>
                                <div class="text-xs text-gray-400"><%= u.phone %></div>
                            </div>
                        </div>
                        <div class="text-right">
                            <div class="text-purple-400 font-bold"><%= u.referralCount %> 👥</div>
                            <div class="text-xs text-gray-500"><%= u.referralRewards * 100 %>MB</div>
                        </div>
                    </div>
                <% }); %>
            </div>
        <% } %>
    </div>

    <!-- Recent Referrals -->
    <div class="glass rounded-2xl p-6">
        <h2 class="text-xl font-bold text-white mb-4">📋 <%= lang === 'sw' ? 'Rufaa za Hivi Karibuni' : 'Recent Referrals' %></h2>
        <% if (recentReferrals.length === 0) { %>
            <p class="text-gray-400 text-center py-6 text-sm">
                <%= lang === 'sw' ? 'Hakuna bado' : 'None yet' %>
            </p>
        <% } else { %>
            <div class="space-y-2">
                <% recentReferrals.forEach(function(r) { %>
                    <div class="flex justify-between items-center p-3 bg-white/5 rounded-xl">
                        <div class="text-sm">
                            <div class="text-white"><%= r.referrerName %> → <%= r.newUserName %></div>
                            <div class="text-xs text-gray-400"><%= r.referrerPhone %> invited <%= r.newUserPhone %></div>
                        </div>
                        <div class="text-right">
                            <div class="text-green-400 font-bold text-sm">+<%= r.rewardMb %>MB</div>
                            <div class="text-xs text-gray-500"><%= new Date(r.date).toLocaleDateString('en-TZ') %></div>
                        </div>
                    </div>
                <% }); %>
            </div>
        <% } %>
    </div>
</div>

<%- include('partials/footer') %>