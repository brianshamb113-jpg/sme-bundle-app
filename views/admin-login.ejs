<%- include('partials/header') %>

<div class="max-w-md mx-auto px-4 py-8">
    <div class="glass rounded-2xl p-8">
        <div class="text-center mb-6">
            <span class="text-4xl">👑</span>
            <h2 class="text-2xl font-bold text-white mt-2">
                <%= lang === 'sw' ? 'Admin Ingia' : 'Admin Login' %>
            </h2>
            <p class="text-gray-400 text-sm">
                <%= lang === 'sw' ? 'Ingia kwenye mfumo wa admin' : 'Access admin dashboard' %>
            </p>
        </div>

        <% if (typeof error !== 'undefined' && error) { %>
            <div class="bg-red-500/20 border border-red-500/30 text-red-300 p-3 rounded-xl text-sm mb-4 text-center">
                <%= error %>
            </div>
        <% } %>

        <form action="/admin-login" method="POST">
            <div class="mb-6">
                <label class="block text-white text-sm font-semibold mb-2">
                    <%= lang === 'sw' ? 'Nenosiri la Admin' : 'Admin Password' %>
                </label>
                <input type="password" name="password" placeholder="••••••••" required
                       class="w-full px-4 py-3 bg-white/10 border border-white/20 rounded-xl text-white placeholder-gray-400 focus:outline-none focus:ring-2 focus:ring-blue-500">
            </div>
            <button type="submit" class="w-full py-3 bg-gradient-to-r from-blue-500 to-purple-600 rounded-xl font-semibold text-white hover:scale-105 transition">
                <%= lang === 'sw' ? 'Ingia' : 'Login' %>
            </button>
        </form>
    </div>
</div>

<%- include('partials/footer') %>