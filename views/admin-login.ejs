<!DOCTYPE html>
<html lang="<%= lang === 'sw' ? 'sw' : 'en' %>">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title><%= lang === 'sw' ? 'Admin Ingia' : 'Admin Login' %> - SME Bundles</title>
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700;800&display=swap" rel="stylesheet">
    <script src="https://cdn.tailwindcss.com"></script>
    <script>
    // Language toggle via fetch (no page reload needed)
    function toggleLanguage() {
        fetch('/toggle-language')
            .then(response => {
                // After toggling, reload the page to show the new language
                window.location.reload();
            })
            .catch(error => {
                console.error('Language toggle failed:', error);
                // Fallback: just reload the page
                window.location.reload();
            });
    }
</script>
    <style>
        * { font-family: 'Inter', sans-serif; }
        .glass {
            background: rgba(255, 255, 255, 0.05);
            backdrop-filter: blur(12px);
            border: 1px solid rgba(255, 255, 255, 0.12);
        }
        .animated-bg {
            background: linear-gradient(-45deg, #0a0a1a, #1a1a3e, #0d1b2a, #1a0a2e);
            background-size: 400% 400%;
            animation: gradient 15s ease infinite;
            min-height: 100vh;
            display: flex;
            align-items: center;
            justify-content: center;
        }
        @keyframes gradient {
            0% { background-position: 0% 50%; }
            50% { background-position: 100% 50%; }
            100% { background-position: 0% 50%; }
        }
    </style>
</head>
<body>
    <div class="animated-bg">
        <div class="glass rounded-2xl p-8 max-w-md w-full">
            <div class="text-center mb-6">
                <span class="text-4xl">👑</span>
                <h2 class="text-2xl font-bold text-white mt-2"><%= lang === 'sw' ? 'Admin Ingia' : 'Admin Login' %></h2>
                <p class="text-gray-400 text-sm"><%= lang === 'sw' ? 'Ingia kwenye mfumo wa admin' : 'Access admin dashboard' %></p>
            </div>

            <% if (error) { %>
                <div class="bg-red-500/20 border border-red-500/30 text-red-300 p-3 rounded-xl text-sm mb-4">
                    <%= error %>
                </div>
            <% } %>
            <form action="/admin-login" method="POST">
                <div class="mb-6">
                    <label class="block text-white text-sm font-semibold mb-2">
                        <%= lang === 'sw' ? 'Nenosiri la Admin' : 'Admin Password' %>
                    </label>
                    <input type="password" name="password" placeholder="••••••••" required
                           class="w-full px-4 py-3 bg-white/10 border border-white/20 rounded-xl text-white placeholder-gray-400 focus:outline-none focus:ring-2 focus:ring-blue-500">
                </div>
                <button type="submit" class="w-full py-3 bg-gradient-to-r from-blue-500 to-purple-600 rounded-xl font-semibold text-white hover:scale-105 transition duration-300">
                    <%= lang === 'sw' ? 'Ingia' : 'Login' %>
                </button>
            </form>
            <div><a href="/toggle-language" class="text-sm text-white/80 hover:text-white transition">
    <%= lang === 'sw' ? '🇬🇧 English' : '🇹🇿 Kiswahili' %>
</a></div>

            <div class="flex justify-center mt-4">
                <a href="/" class="text-sm text-white/60 hover:text-white transition">🏠 Home</a>
            </div>
        </div>
    </div>
</body>
</html>