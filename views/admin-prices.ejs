<%- include('partials/header') %>

<div class="max-w-6xl mx-auto px-4 py-8">
    <div class="flex justify-between items-center mb-6 flex-wrap gap-3">
        <h1 class="text-2xl font-bold text-white">💰 <%= lang === 'sw' ? 'Usimamizi wa Bei' : 'Price Manager' %></h1>
        <a href="/admin" class="text-sm text-gray-400 hover:text-white transition">
            ← <%= lang === 'sw' ? 'Rudi Admin' : 'Back to Admin' %>
        </a>
    </div>

    <% if (typeof success !== 'undefined' && success) { %>
        <div class="bg-green-500/20 border border-green-500/30 text-green-300 p-3 rounded-xl mb-4">
            ✅ <%= lang === 'sw' ? 'Bei zimehifadhiwa!' : 'Prices saved!' %>
        </div>
    <% } %>

    <div class="bg-blue-500/20 border border-blue-500/30 text-blue-300 p-4 rounded-xl mb-6">
        <p class="text-sm">
            📌 <strong><%= lang === 'sw' ? 'Kidokezo:' : 'Tip:' %></strong>
            <%= lang === 'sw' 
                ? 'Weka bei yako ya kuuza na gharama yako ya kununua ili kuona faida papara.' 
                : 'Enter your selling price and your wholesale cost to see profit instantly.' %>
        </p>
    </div>

    <form action="/admin/prices/save" method="POST">
        <% networks.forEach(function(network, netIndex) { %>
            <div class="glass rounded-2xl p-6 mb-6">
                <div class="flex items-center gap-3 mb-4">
                    <img src="<%= network.logo %>" alt="<%= network.networkName %>" class="h-10 w-10 object-contain bg-white/10 rounded-lg p-1">
                    <h2 class="text-xl font-bold text-white"><%= network.networkName %></h2>
                </div>

                <!-- Small Plans -->
                <h3 class="text-sm font-bold text-blue-300 mb-3 mt-4">
                    📱 <%= lang === 'sw' ? 'Bundles Ndogo' : 'Small Bundles' %>
                </h3>
                <div class="space-y-2 mb-4">
                    <% network.smallPlans.forEach(function(plan, planIndex) { %>
                        <div class="grid grid-cols-12 gap-2 items-center bg-white/5 rounded-xl p-2">
                            <div class="col-span-2 text-white font-bold"><%= plan.gb %>GB</div>
                            <div class="col-span-4">
                                <label class="text-xs text-gray-400 block mb-1"><%= lang === 'sw' ? 'Bei ya Kuuza' : 'Selling Price' %></label>
                                <input type="number" 
                                       name="network_<%= netIndex %>_small_<%= planIndex %>_price"
                                       value="<%= plan.price %>"
                                       class="w-full px-3 py-2 bg-white/10 border border-white/20 rounded-lg text-white text-sm">
                            </div>
                            <div class="col-span-4">
                                <label class="text-xs text-gray-400 block mb-1"><%= lang === 'sw' ? 'Gharama Yako' : 'Your Cost' %></label>
                                <input type="number"
                                       name="network_<%= netIndex %>_small_<%= planIndex %>_cost"
                                       value="<%= plan.cost %>"
                                       class="w-full px-3 py-2 bg-white/10 border border-white/20 rounded-lg text-white text-sm">
                            </div>
                            <div class="col-span-2 text-right">
                                <% 
                                    const smallProfit = plan.price - plan.cost - Math.round(plan.price * 0.02);
                                    const smallColor = smallProfit > 1000 ? 'text-green-400' : smallProfit > 0 ? 'text-yellow-400' : 'text-red-400';
                                %>
                                <div class="text-xs text-gray-400"><%= lang === 'sw' ? 'Faida' : 'Profit' %></div>
                                <div class="<%= smallColor %> font-bold text-sm"><%= smallProfit %></div>
                            </div>
                        </div>
                    <% }); %>
                </div>

                <!-- Data Plans -->
                <h3 class="text-sm font-bold text-purple-300 mb-3 mt-6">
                    📶 <%= lang === 'sw' ? 'Bundles Kubwa' : 'Big Data Plans' %>
                </h3>
                <div class="space-y-2">
                    <% network.dataPlans.forEach(function(plan, planIndex) { %>
                        <div class="grid grid-cols-12 gap-2 items-center bg-white/5 rounded-xl p-2">
                            <div class="col-span-2 text-white font-bold"><%= plan.gb %>GB</div>
                            <div class="col-span-4">
                                <label class="text-xs text-gray-400 block mb-1"><%= lang === 'sw' ? 'Bei ya Kuuza' : 'Selling Price' %></label>
                                <input type="number"
                                       name="network_<%= netIndex %>_data_<%= planIndex %>_price"
                                       value="<%= plan.price %>"
                                       class="w-full px-3 py-2 bg-white/10 border border-white/20 rounded-lg text-white text-sm">
                            </div>
                            <div class="col-span-4">
                                <label class="text-xs text-gray-400 block mb-1"><%= lang === 'sw' ? 'Gharama Yako' : 'Your Cost' %></label>
                                <input type="number"
                                       name="network_<%= netIndex %>_data_<%= planIndex %>_cost"
                                       value="<%= plan.cost %>"
                                       class="w-full px-3 py-2 bg-white/10 border border-white/20 rounded-lg text-white text-sm">
                            </div>
                            <div class="col-span-2 text-right">
                                <% 
                                    const dataProfit = plan.price - plan.cost - Math.round(plan.price * 0.02);
                                    const dataColor = dataProfit > 2000 ? 'text-green-400' : dataProfit > 0 ? 'text-yellow-400' : 'text-red-400';
                                %>
                                <div class="text-xs text-gray-400"><%= lang === 'sw' ? 'Faida' : 'Profit' %></div>
                                <div class="<%= dataColor %> font-bold text-sm"><%= dataProfit %></div>
                            </div>
                        </div>
                    <% }); %>
                </div>
            </div>
        <% }); %>

        <div class="sticky bottom-4">
            <button type="submit" class="w-full py-4 bg-gradient-to-r from-green-500 to-green-600 rounded-xl font-bold text-white text-lg hover:scale-105 transition shadow-lg">
                💾 <%= lang === 'sw' ? 'Hifadhi Bei Zote' : 'Save All Prices' %>
            </button>
        </div>
    </form>
</div>

<%- include('partials/footer') %>