<%- include('partials/header') %>

<div class="max-w-6xl mx-auto px-4 py-8">
    <div class="flex justify-between items-center mb-6">
        <h1 class="text-2xl font-bold text-white">👑 <%= lang === 'sw' ? 'Admin Panel' : 'Admin Panel' %></h1>
        <a href="/admin-logout" class="px-4 py-2 bg-red-500/20 border border-red-500/30 rounded-full text-red-300 text-sm font-semibold hover:bg-red-500/30 transition">
            <%= lang === 'sw' ? 'Toka' : 'Logout' %>
        </a>
    </div>

    <!-- Stats -->
    <div class="grid grid-cols-2 md:grid-cols-4 gap-4 mb-6">
        <div class="glass rounded-2xl p-6 text-center">
            <div class="text-3xl font-bold text-blue-400"><%= totalUsers %></div>
            <div class="text-sm text-gray-400"><%= lang === 'sw' ? 'Watumiaji' : 'Users' %></div>
        </div>
        <div class="glass rounded-2xl p-6 text-center">
            <div class="text-3xl font-bold text-green-400"><%= totalSales %></div>
            <div class="text-sm text-gray-400"><%= lang === 'sw' ? 'Manunuzi' : 'Sales' %></div>
        </div>
        <div class="glass rounded-2xl p-6 text-center">
            <div class="text-3xl font-bold text-purple-400"><%= totalRevenue.toLocaleString() %></div>
            <div class="text-sm text-gray-400">TZS <%= lang === 'sw' ? 'Mapato' : 'Revenue' %></div>
        </div>
        <div class="glass rounded-2xl p-6 text-center">
            <div class="text-3xl font-bold text-yellow-400"><%= transactions.length %></div>
            <div class="text-sm text-gray-400"><%= lang === 'sw' ? 'Manunuzi Yote' : 'Total' %></div>
        </div>
    </div>

    <!-- Transactions -->
    <div class="glass rounded-2xl p-6">
        <h2 class="text-xl font-bold text-white mb-4">
            📋 <%= lang === 'sw' ? 'Manunuzi Yote' : 'All Transactions' %>
        </h2>
        <% if (transactions.length === 0) { %>
            <p class="text-gray-400 text-center py-8">
                <%= lang === 'sw' ? 'Hakuna manunuzi bado' : 'No transactions yet' %>
            </p>
        <% } else { %>
            <div class="overflow-x-auto">
                <table class="w-full text-sm">
                    <thead class="border-b border-white/10">
                        <tr class="text-left text-gray-400">
                            <th class="pb-3 px-2">ID</th>
                            <th class="pb-3 px-2"><%= lang === 'sw' ? 'Mtumiaji' : 'User' %></th>
                            <th class="pb-3 px-2">Bundle</th>
                            <th class="pb-3 px-2"><%= lang === 'sw' ? 'Kiasi' : 'Amount' %></th>
                            <th class="pb-3 px-2"><%= lang === 'sw' ? 'Njia' : 'Method' %></th>
                            <th class="pb-3 px-2"><%= lang === 'sw' ? 'Hali' : 'Status' %></th>
                            <th class="pb-3 px-2"><%= lang === 'sw' ? 'Tarehe' : 'Date' %></th>
                        </tr>
                    </thead>
                    <tbody>
                        <% transactions.forEach(function(t) { %>
                            <tr class="border-b border-white/5">
                                <td class="py-3 px-2 text-white/60 text-xs"><%= t.id %></td>
                                <td class="py-3 px-2 text-white"><%= t.phone %></td>
                                <td class="py-3 px-2 text-white"><%= t.bundleName %></td>
                                <td class="py-3 px-2 text-green-400 font-semibold">TZS <%= t.amount.toLocaleString() %></td>
                                <td class="py-3 px-2 text-white/80"><%= t.paymentMethod %></td>
                                <td class="py-3 px-2">
                                    <span class="px-2 py-1 rounded-full text-xs <%= t.status === 'completed' ? 'bg-green-500/20 text-green-300' : 'bg-yellow-500/20 text-yellow-300' %>">
                                        <%= t.status === 'completed' ? '✅' : '⏳' %>
                                    </span>
                                </td>
                                <td class="py-3 px-2 text-white/60 text-xs"><%= new Date(t.date).toLocaleString('en-TZ') %></td>
                            </tr>
                        <% }); %>
                    </tbody>
                </table>
            </div>
        <% } %>
    </div>
</div>

<%- include('partials/footer') %>