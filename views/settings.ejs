<%- include('partials/header') %>

<div class="max-w-3xl mx-auto px-4 py-8">

    <h1 class="text-3xl font-bold text-white mb-2">
        ⚙️ <%= lang === 'sw' ? 'Mipangilio' : 'Settings' %>
    </h1>
    <p class="text-gray-400 mb-8">
        <%= lang === 'sw' ? 'Simamia akaunti yako na mipangilio' : 'Manage your account and preferences' %>
    </p>

    <!-- Success/Error Messages -->
    <% if (typeof success !== 'undefined' && success === 'profile') { %>
        <div class="bg-green-500/20 border border-green-500/30 text-green-300 p-4 rounded-xl mb-6">
            ✅ <%= lang === 'sw' ? 'Jina limebadilishwa kikamilifu!' : 'Name updated successfully!' %>
        </div>
    <% } %>
    <% if (typeof success !== 'undefined' && success === 'password') { %>
        <div class="bg-green-500/20 border border-green-500/30 text-green-300 p-4 rounded-xl mb-6">
            ✅ <%= lang === 'sw' ? 'Nenosiri limebadilishwa kikamilifu!' : 'Password changed successfully!' %>
        </div>
    <% } %>
    <% if (typeof error !== 'undefined' && error === 'wrongpassword') { %>
        <div class="bg-red-500/20 border border-red-500/30 text-red-300 p-4 rounded-xl mb-6">
            ❌ <%= lang === 'sw' ? 'Nenosiri la sasa si sahihi!' : 'Current password is incorrect!' %>
        </div>
    <% } %>
    <% if (typeof error !== 'undefined' && error === 'shortpassword') { %>
        <div class="bg-red-500/20 border border-red-500/30 text-red-300 p-4 rounded-xl mb-6">
            ❌ <%= lang === 'sw' ? 'Nenosiri jipya lazima liwe na herufi 6 au zaidi!' : 'New password must be 6+ characters!' %>
        </div>
    <% } %>
    <% if (typeof error !== 'undefined' && error === 'mismatch') { %>
        <div class="bg-red-500/20 border border-red-500/30 text-red-300 p-4 rounded-xl mb-6">
            ❌ <%= lang === 'sw' ? 'Manenosiri hayafanani!' : 'Passwords do not match!' %>
        </div>
    <% } %>

    <!-- Account Stats -->
    <div class="glass rounded-2xl p-6 mb-6">
        <h2 class="text-xl font-bold text-white mb-4">
            📊 <%= lang === 'sw' ? 'Taarifa za Akaunti' : 'Account Statistics' %>
        </h2>
        <div class="grid grid-cols-2 md:grid-cols-4 gap-4">
            <div class="text-center">
                <div class="text-2xl font-bold text-blue-400"><%= totalPurchases %></div>
                <div class="text-xs text-gray-400"><%= lang === 'sw' ? 'Manunuzi' : 'Purchases' %></div>
            </div>
            <div class="text-center">
                <div class="text-2xl font-bold text-green-400"><%= totalSpent.toLocaleString() %></div>
                <div class="text-xs text-gray-400"><%= lang === 'sw' ? 'TZS Zilizotumika' : 'TZS Spent' %></div>
            </div>
            <div class="text-center">
                <div class="text-2xl font-bold text-purple-400"><%= user.phone %></div>
                <div class="text-xs text-gray-400"><%= lang === 'sw' ? 'Simu' : 'Phone' %></div>
            </div>
            <div class="text-center">
                <div class="text-2xl font-bold text-yellow-400">
                    <%= new Date(memberSince).toLocaleDateString('en-TZ', { month: 'short', year: 'numeric' }) %>
                </div>
                <div class="text-xs text-gray-400"><%= lang === 'sw' ? 'Mwanachama' : 'Member Since' %></div>
            </div>
        </div>
    </div>

    <!-- Update Profile -->
    <div class="glass rounded-2xl p-6 mb-6">
        <h2 class="text-xl font-bold text-white mb-4">
            👤 <%= lang === 'sw' ? 'Badilisha Taarifa' : 'Update Profile' %>
        </h2>
        <form action="/settings/profile" method="POST">
            <div class="mb-4">
                <label class="block text-white text-sm font-semibold mb-2">
                    <%= lang === 'sw' ? 'Jina Kamili' : 'Full Name' %>
                </label>
                <input type="text" name="fullname" value="<%= userDetails.fullname %>" required
                       class="w-full px-4 py-3 bg-white/10 border border-white/20 rounded-xl text-white placeholder-gray-400 focus:outline-none focus:ring-2 focus:ring-blue-500">
            </div>
            <div class="mb-4">
                <label class="block text-white text-sm font-semibold mb-2">
                    <%= lang === 'sw' ? 'Namba ya Simu' : 'Phone Number' %>
                </label>
                <input type="tel" value="<%= user.phone %>" disabled
                       class="w-full px-4 py-3 bg-white/5 border border-white/10 rounded-xl text-gray-500 cursor-not-allowed">
                <p class="text-xs text-gray-500 mt-1">
                    <%= lang === 'sw' ? 'Namba ya simu haiwezi kubadilishwa' : 'Phone number cannot be changed' %>
                </p>
            </div>
            <button type="submit" class="w-full py-3 bg-gradient-to-r from-blue-500 to-purple-600 rounded-xl font-semibold text-white hover:scale-105 transition">
                💾 <%= lang === 'sw' ? 'Hifadhi Mabadiliko' : 'Save Changes' %>
            </button>
        </form>
    </div>

    <!-- Change Password -->
    <div class="glass rounded-2xl p-6 mb-6">
        <h2 class="text-xl font-bold text-white mb-4">
            🔒 <%= lang === 'sw' ? 'Badilisha Nenosiri' : 'Change Password' %>
        </h2>
        <form action="/settings/password" method="POST">
            <div class="mb-4">
                <label class="block text-white text-sm font-semibold mb-2">
                    <%= lang === 'sw' ? 'Nenosiri la Sasa' : 'Current Password' %>
                </label>
                <input type="password" name="currentPassword" required
                       class="w-full px-4 py-3 bg-white/10 border border-white/20 rounded-xl text-white placeholder-gray-400 focus:outline-none focus:ring-2 focus:ring-blue-500">
            </div>
            <div class="mb-4">
                <label class="block text-white text-sm font-semibold mb-2">
                    <%= lang === 'sw' ? 'Nenosiri Jipya' : 'New Password' %>
                </label>
                <input type="password" name="newPassword" required minlength="6"
                       class="w-full px-4 py-3 bg-white/10 border border-white/20 rounded-xl text-white placeholder-gray-400 focus:outline-none focus:ring-2 focus:ring-blue-500">
            </div>
            <div class="mb-4">
                <label class="block text-white text-sm font-semibold mb-2">
                    <%= lang === 'sw' ? 'Rudia Nenosiri Jipya' : 'Confirm New Password' %>
                </label>
                <input type="password" name="confirmPassword" required minlength="6"
                       class="w-full px-4 py-3 bg-white/10 border border-white/20 rounded-xl text-white placeholder-gray-400 focus:outline-none focus:ring-2 focus:ring-blue-500">
            </div>
            <button type="submit" class="w-full py-3 bg-gradient-to-r from-green-500 to-green-600 rounded-xl font-semibold text-white hover:scale-105 transition">
                🔐 <%= lang === 'sw' ? 'Badilisha Nenosiri' : 'Change Password' %>
            </button>
        </form>
    </div>

    <!-- Danger Zone -->
    <div class="glass rounded-2xl p-6 border border-red-500/20">
        <h2 class="text-xl font-bold text-red-400 mb-4">
            ⚠️ <%= lang === 'sw' ? 'Eneo la Hatari' : 'Danger Zone' %>
        </h2>
        <p class="text-gray-400 text-sm mb-4">
            <%= lang === 'sw' ? 'Toka kwenye akaunti yako kwenye kifaa hiki' : 'Log out from your account on this device' %>
        </p>
        <a href="/logout" class="inline-block px-6 py-3 bg-red-500/20 border border-red-500/30 rounded-xl text-red-300 font-semibold hover:bg-red-500/30 transition">
            🚪 <%= lang === 'sw' ? 'Toka' : 'Logout' %>
        </a>
    </div>

</div>

<%- include('partials/footer') %>