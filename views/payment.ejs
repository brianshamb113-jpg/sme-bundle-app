<%- include('partials/header') %>
<div class="max-w-3xl mx-auto px-4 py-8">

    <div class="glass rounded-2xl p-6 mb-6">
        <h2 class="text-xl font-bold text-white mb-4">
            <span class="text-blue-400">1.</span> 
            <%= lang === 'sw' ? 'Chagua Mtandao Wako' : 'Choose Your Network' %>
        </h2>
        <div class="grid grid-cols-2 md:grid-cols-4 gap-3" id="providerGrid">
            <% providers.forEach(function(provider) { %>
                <div class="provider-card glass rounded-xl p-4 text-center cursor-pointer hover:bg-white/10 transition border-2 border-transparent" 
                     data-provider="<%= provider.id %>" 
                     data-payment="<%= provider.paymentMethod %>"
                     data-name="<%= provider.name %>">
                    <img src="<%= provider.logo %>" alt="<%= provider.name %>" class="h-12 mx-auto mb-2 object-contain">
                    <div class="text-xs font-semibold text-white"><%= provider.name %></div>
                </div>
            <% }); %>
        </div>
    </div>

    <div class="glass rounded-2xl p-6 mb-6 hidden" id="plansSection">
        <h2 class="text-xl font-bold text-white mb-4">
            <span class="text-blue-400">2.</span> 
            <%= lang === 'sw' ? 'Chagua Bundle Yako' : 'Choose Your Bundle' %>
        </h2>
        <div class="grid grid-cols-2 md:grid-cols-3 lg:grid-cols-5 gap-3" id="planGrid">
            <% plans.forEach(function(plan) { %>
                <div class="plan-card glass rounded-xl p-3 text-center cursor-pointer hover:bg-white/10 transition border-2 border-transparent"
                     data-gb="<%= plan.gb %>"
                     data-price="<%= plan.price %>">
                    <div class="text-2xl font-bold text-blue-400"><%= plan.gb %>GB</div>
                    <div class="text-sm font-bold text-white mt-1">TZS <%= plan.price.toLocaleString() %></div>
                    <div class="text-xs text-gray-400 line-through">TZS <%= plan.originalPrice.toLocaleString() %></div>
                    <div class="text-xs text-green-400 font-semibold mt-1">
                        💚 <%= lang === 'sw' ? 'Okoa' : 'Save' %> <%= (plan.originalPrice - plan.price).toLocaleString() %>
                    </div>
                </div>
            <% }); %>
        </div>
    </div>

    <div class="glass rounded-2xl p-6 hidden" id="confirmSection">
        <h2 class="text-xl font-bold text-white mb-4">
            <span class="text-blue-400">3.</span> 
            <%= lang === 'sw' ? 'Thibitisha Malipo' : 'Confirm Payment' %>
        </h2>
        
        <div class="bg-white/5 rounded-xl p-4 mb-4">
            <div class="flex justify-between mb-2">
                <span class="text-gray-400 text-sm"><%= lang === 'sw' ? 'Mtandao' : 'Network' %>:</span>
                <span class="text-white font-semibold text-sm" id="summaryProvider">-</span>
            </div>
            <div class="flex justify-between mb-2">
                <span class="text-gray-400 text-sm"><%= lang === 'sw' ? 'Bundle' : 'Bundle' %>:</span>
                <span class="text-white font-semibold text-sm" id="summaryBundle">-</span>
            </div>
            <div class="flex justify-between border-t border-white/10 pt-2 mt-2">
                <span class="text-gray-400 text-sm"><%= lang === 'sw' ? 'Jumla' : 'Total' %>:</span>
                <span class="text-blue-400 font-bold" id="summaryTotal">-</span>
            </div>
        </div>

        <% if (typeof error !== 'undefined' && error) { %>
            <div class="bg-red-500/20 border border-red-500/30 text-red-300 p-3 rounded-xl text-sm mb-4 text-center">
                <%= error %>
            </div>
        <% } %>

        <form action="/process-payment" method="POST" id="paymentForm">
            <input type="hidden" name="planGb" id="inputPlanGb" value="">
            <input type="hidden" name="paymentMethod" id="inputPaymentMethod" value="">
            <input type="hidden" name="providerName" id="inputProviderName" value="">

            <div class="mb-4">
                <label class="block text-white text-sm font-semibold mb-2">
                    <%= lang === 'sw' ? 'Namba yako ya Simu' : 'Your Phone Number' %>
                </label>
                <input type="tel" name="phoneNumber" placeholder="0712345678" required
                       class="w-full px-4 py-3 bg-white/10 border border-white/20 rounded-xl text-white placeholder-gray-400 focus:outline-none focus:ring-2 focus:ring-blue-500">
            </div>

            <button type="submit" id="payBtn" class="w-full py-4 bg-gradient-to-r from-green-500 to-green-600 rounded-xl font-bold text-white hover:scale-105 transition duration-300 text-lg">
                ✅ <%= lang === 'sw' ? 'Thibitisha Malipo' : 'Confirm Payment' %>
            </button>
        </form>
        
        <div class="text-center mt-4">
            <a href="/dashboard" class="text-sm text-gray-400 hover:text-white transition">
                ← <%= lang === 'sw' ? 'Rudi' : 'Back' %>
            </a>
        </div>
    </div>
</div>

<style>
    .provider-card.selected {
        border-color: #3b82f6 !important;
        background: rgba(59, 130, 246, 0.15) !important;
        transform: scale(1.05);
    }
    .plan-card.selected {
        border-color: #3b82f6 !important;
        background: rgba(59, 130, 246, 0.15) !important;
    }
</style>

<script>
document.addEventListener('DOMContentLoaded', function() {
    let selectedProvider = null;
    let selectedPlan = null;

    document.querySelectorAll('.provider-card').forEach(card => {
        card.addEventListener('click', function() {
            document.querySelectorAll('.provider-card').forEach(c => c.classList.remove('selected'));
            this.classList.add('selected');
            selectedProvider = {
                payment: this.dataset.payment,
                name: this.dataset.name
            };
            
            document.getElementById('plansSection').classList.remove('hidden');
            document.getElementById('confirmSection').classList.add('hidden');
            document.querySelectorAll('.plan-card').forEach(p => p.classList.remove('selected'));
            
            document.getElementById('plansSection').scrollIntoView({ behavior: 'smooth', block: 'center' });
        });
    });

    document.querySelectorAll('.plan-card').forEach(card => {
        card.addEventListener('click', function() {
            document.querySelectorAll('.plan-card').forEach(p => p.classList.remove('selected'));
            this.classList.add('selected');
            selectedPlan = {
                gb: this.dataset.gb,
                price: parseInt(this.dataset.price)
            };

            document.getElementById('summaryProvider').textContent = selectedProvider.name;
            document.getElementById('summaryBundle').textContent = selectedPlan.gb + 'GB SME Bundle';
            document.getElementById('summaryTotal').textContent = 'TZS ' + selectedPlan.price.toLocaleString();

            document.getElementById('inputPlanGb').value = selectedPlan.gb;
            document.getElementById('inputPaymentMethod').value = selectedProvider.payment;
            document.getElementById('inputProviderName').value = selectedProvider.name;

            document.getElementById('confirmSection').classList.remove('hidden');
            document.getElementById('confirmSection').scrollIntoView({ behavior: 'smooth', block: 'center' });
        });
    });

    document.getElementById('paymentForm').addEventListener('submit', function() {
        const btn = document.getElementById('payBtn');
        btn.disabled = true;
        btn.textContent = 'Processing...';
    });
});
</script>


<%- include('partials/footer') %>