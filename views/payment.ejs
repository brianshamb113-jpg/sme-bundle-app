<%- include('partials/header') %>
<!-- Hidden: Default bundle from dashboard -->
<div id="defaultBundleData"
     data-gb="<%= bundle.gb %>"
     data-price="<%= bundle.price %>"
     data-name="<%= bundle.name %>"
     data-original="<%= bundle.originalPrice %>"
     style="display:none;"></div>
<div class="max-w-3xl mx-auto px-4 py-6">

    <!-- STEP 1: Choose Network -->
    <div class="glass rounded-2xl p-5 mb-5">
        <h2 class="text-lg font-bold text-white mb-4">
            <span class="text-blue-400">1.</span>
            <%= lang === 'sw' ? 'Chagua Mtandao Wako' : 'Choose Your Network' %>
        </h2>
        <div class="grid grid-cols-2 md:grid-cols-4 gap-3" id="providerGrid">
            <% providers.forEach(function(provider) { %>
                <div class="provider-card glass rounded-xl p-3 text-center cursor-pointer hover:bg-white/10 transition border-2 border-transparent"
                     data-provider="<%= provider.id %>"
                     data-payment="<%= provider.paymentMethod %>"
                     data-name="<%= provider.name %>">
                    <img src="<%= provider.logo %>" alt="<%= provider.name %>" class="h-10 mx-auto mb-2 object-contain">
                    <div class="text-xs font-semibold text-white"><%= provider.name %></div>
                </div>
            <% }); %>
        </div>
    </div>

    <!-- STEP 2: Your Selection (default from dashboard) -->
    <div class="glass rounded-2xl p-5 mb-5 hidden" id="selectionSection">
        <h2 class="text-lg font-bold text-white mb-4">
            <span class="text-blue-400">2.</span>
            <%= lang === 'sw' ? 'Umechagua' : 'Your Selection' %>
        </h2>

        <div class="bg-gradient-to-r from-blue-500/20 to-purple-600/20 border-2 border-blue-500/40 rounded-xl p-5 mb-4">
            <div class="flex justify-between items-center">
                <div>
                    <div class="text-2xl font-bold text-white"><%= bundle.gb %> GB</div>
                    <div class="text-xs text-gray-300 mt-1"><%= bundle.name %></div>
                </div>
                <div class="text-right">
                    <div class="text-3xl font-bold text-blue-400">TZS <%= bundle.price.toLocaleString() %></div>
                    <div class="text-xs text-green-400 mt-1">
                        💚 <%= lang === 'sw' ? 'Okoa' : 'Save' %> <%= (bundle.originalPrice - bundle.price).toLocaleString() %>
                    </div>
                </div>
            </div>
        </div>

        <div class="grid grid-cols-1 sm:grid-cols-2 gap-3">
            <button type="button" id="continueBtn" class="py-3 bg-gradient-to-r from-green-500 to-green-600 rounded-xl font-bold text-white hover:scale-105 transition">
                ✅ <%= lang === 'sw' ? 'Endelea na Hii' : 'Continue with This' %>
            </button>
            <button type="button" id="morePlansBtn" class="py-3 glass rounded-xl font-bold text-white hover:bg-white/10 transition">
                📶 <%= lang === 'sw' ? 'Ona Chaguzi Zaidi' : 'See More Options' %>
            </button>
        </div>
    </div>

    <!-- STEP 3: More Plans (hidden until user clicks "See More") -->
    <div class="glass rounded-2xl p-5 mb-5 hidden" id="morePlansSection">
        <h2 class="text-lg font-bold text-white mb-4">
            <span class="text-blue-400">3.</span>
            <%= lang === 'sw' ? 'Chaguzi Zaidi' : 'More Options' %>
        </h2>

        <div class="flex gap-2 mb-4" id="planTypeTabs">
            <button type="button" id="tabSmall" class="plan-tab active flex-1 py-2 rounded-xl font-semibold text-xs sm:text-sm transition">
                📱 <%= lang === 'sw' ? 'Ndogo' : 'Small' %>
            </button>
            <button type="button" id="tabData" class="plan-tab flex-1 py-2 rounded-xl font-semibold text-xs sm:text-sm transition">
                📶 <%= lang === 'sw' ? 'Kubwa' : 'Big' %>
            </button>
            <button type="button" id="tabCombo" class="plan-tab flex-1 py-2 rounded-xl font-semibold text-xs sm:text-sm transition hidden">
                🎁 <%= lang === 'sw' ? 'Combo' : 'Combo' %>
            </button>
        </div>

        <div class="grid grid-cols-2 md:grid-cols-3 lg:grid-cols-4 gap-3" id="planGrid">
            <!-- Filled by JavaScript -->
        </div>
    </div>

    <!-- STEP 4: Confirm -->
    <div class="glass rounded-2xl p-5 hidden" id="confirmSection">
        <h2 class="text-lg font-bold text-white mb-4">
            <span class="text-blue-400">4.</span>
            <%= lang === 'sw' ? 'Thibitisha Malipo' : 'Confirm Payment' %>
        </h2>

        <div class="bg-white/5 rounded-xl p-4 mb-4">
            <div class="flex justify-between mb-2">
                <span class="text-gray-400 text-sm"><%= lang === 'sw' ? 'Mtandao' : 'Network' %>:</span>
                <span class="text-white font-semibold text-sm" id="summaryProvider">-</span>
            </div>
            <div class="flex justify-between mb-2">
                <span class="text-gray-400 text-sm"><%= lang === 'sw' ? 'Bundle' : 'Bundle' %>:</span>
                <span class="text-white font-semibold text-sm" id="summaryBundle">-</span>
            </div>
            <div class="flex justify-between border-t border-white/10 pt-2 mt-2">
                <span class="text-gray-400 text-sm"><%= lang === 'sw' ? 'Jumla' : 'Total' %>:</span>
                <span class="text-blue-400 font-bold text-lg" id="summaryTotal">-</span>
            </div>
        </div>

        <% if (typeof error !== 'undefined' && error) { %>
            <div class="bg-red-500/20 border border-red-500/30 text-red-300 p-3 rounded-xl text-sm mb-4 text-center">
                <%= error %>
            </div>
        <% } %>

        <form action="/process-payment" method="POST" id="paymentForm">
            <input type="hidden" name="planGb" id="inputPlanGb" value="">
            <input type="hidden" name="planPrice" id="inputPlanPrice" value="">
            <input type="hidden" name="planType" id="inputPlanType" value="">
            <input type="hidden" name="planLabel" id="inputPlanLabel" value="">
            <input type="hidden" name="paymentMethod" id="inputPaymentMethod" value="">
            <input type="hidden" name="providerName" id="inputProviderName" value="">

            <div class="mb-4">
                <label class="block text-white text-sm font-semibold mb-2">
                    <%= lang === 'sw' ? 'Namba yako ya Simu' : 'Your Phone Number' %>
                </label>
                <input type="tel" name="phoneNumber" placeholder="0712345678" required
                       class="w-full px-4 py-3 bg-white/10 border border-white/20 rounded-xl text-white placeholder-gray-400 focus:outline-none focus:ring-2 focus:ring-blue-500">
            </div>

            <button type="submit" id="payBtn" class="w-full py-4 bg-gradient-to-r from-green-500 to-green-600 rounded-xl font-bold text-white hover:scale-105 transition text-lg">
                ✅ <%= lang === 'sw' ? 'Thibitisha Malipo' : 'Confirm Payment' %>
            </button>
        </form>

        <div class="text-center mt-4">
            <a href="/dashboard" class="text-sm text-gray-400 hover:text-white transition">
                ← <%= lang === 'sw' ? 'Rudi' : 'Back' %>
            </a>
        </div>
    </div>
</div>

<style>
    .provider-card.selected {
        border-color: #3b82f6 !important;
        background: rgba(59, 130, 246, 0.15) !important;
        transform: scale(1.03);
    }
    .plan-card.selected {
        border-color: #3b82f6 !important;
        background: rgba(59, 130, 246, 0.15) !important;
    }
    .plan-tab {
        background: rgba(255,255,255,0.05);
        border: 2px solid transparent;
        color: #b9becf;
    }
    .plan-tab:hover { background: rgba(255,255,255,0.1); }
    .plan-tab.active {
        background: linear-gradient(135deg, #3b82f6, #8b5cf6);
        color: white;
        border-color: rgba(255,255,255,0.2);
    }
</style>

<script>
// ============================================
// DEFAULT BUNDLE (read from hidden data element)
// ============================================
const bundleData = document.getElementById('defaultBundleData');
const DEFAULT_BUNDLE = {
    gb: parseInt(bundleData.dataset.gb),
    price: parseInt(bundleData.dataset.price),
    name: bundleData.dataset.name,
    originalPrice: parseInt(bundleData.dataset.original)
};

// ============================================
// NETWORK PLANS (per provider)
// ============================================
const SMALL_PLANS = [
    { gb: 1, price: 1200, note: '1GB' },
    { gb: 2, price: 2400, note: '2GB' },
    { gb: 3, price: 3600, note: '3GB' },
    { gb: 5, price: 6000, note: '5GB' },
    { gb: 10, price: 12000, note: '10GB' }
];

const NETWORK_PLANS = {
    yas: {
        name: 'Yas (Tigo)',
        smallPlans: SMALL_PLANS,
        dataPlans: [
            { gb: 15, price: 15000, note: 'Kila Mwezi' },
            { gb: 35, price: 30000, note: 'Kila Mwezi' },
            { gb: 48, price: 40000, note: 'Kila Mwezi' }
        ],
        comboPlans: [
            { gb: 10, price: 15000, note: 'Kila Mwezi', extra: 'GB 10 + DK 400' },
            { gb: 25, price: 30000, note: 'Kila Mwezi', extra: 'GB 25 + DK 1000' },
            { gb: 35, price: 40000, note: 'Kila Mwezi', extra: 'GB 35 + DK 2000' }
        ]
    },
    halotel: {
        name: 'Halotel',
        smallPlans: SMALL_PLANS,
        dataPlans: [
            { gb: 5,  price: 6000,  note: 'Internet Bundle' },
            { gb: 10, price: 11000, note: 'Internet Bundle' },
            { gb: 15, price: 15000, note: 'Internet Bundle' },
            { gb: 20, price: 20000, note: 'Internet Bundle' },
            { gb: 25, price: 25000, note: 'Internet Bundle' },
            { gb: 30, price: 30000, note: 'Internet Bundle' }
        ],
        comboPlans: []
    },
    airtel: {
        name: 'Airtel',
        smallPlans: SMALL_PLANS,
        dataPlans: [
            { gb: 5,  price: 5000,  note: 'Data Bundle' },
            { gb: 10, price: 10000, note: 'Data Bundle' },
            { gb: 20, price: 20000, note: 'Data Bundle' },
            { gb: 30, price: 30000, note: 'Data Bundle' }
        ],
        comboPlans: []
    },
    vodacom: {
        name: 'Vodacom',
        smallPlans: SMALL_PLANS,
        dataPlans: [
            { gb: 10,  price: 15000,  note: 'Siku 30' },
            { gb: 15,  price: 20000,  note: 'Siku 30' },
            { gb: 30,  price: 30000,  note: 'Siku 30' },
            { gb: 60,  price: 50000,  note: 'Siku 30' },
            { gb: 75,  price: 60000,  note: 'Siku 30' },
            { gb: 100, price: 75000,  note: 'Siku 30' },
            { gb: 150, price: 100000, note: 'Siku 30' }
        ],
        comboPlans: [
            { gb: 7,   price: 15000,  note: 'Siku 30', extra: 'GB 7 + DKK 500 + SMS 100' },
            { gb: 10,  price: 20000,  note: 'Siku 30', extra: 'GB 10 + DKK 1000 + SMS 100' },
            { gb: 20,  price: 30000,  note: 'Siku 30', extra: 'GB 20 + DKK 1500 + SMS 100' },
            { gb: 50,  price: 50000,  note: 'Siku 30', extra: 'GB 50 + DKK 2000 + SMS 100' },
            { gb: 60,  price: 60000,  note: 'Siku 30', extra: 'GB 60 + DKK 3000 + SMS 100' },
            { gb: 80,  price: 75000,  note: 'Siku 30', extra: 'GB 80 + DKK 5000 + SMS 100' },
            { gb: 120, price: 100000, note: 'Siku 30', extra: 'GB 120 + DKK 8000 + SMS 100' }
        ]
    }
};

document.addEventListener('DOMContentLoaded', function() {
    let selectedProvider = null;
    let selectedPlan = null;
    let currentPlanType = 'small';

    // ========== PROVIDER CLICK ==========
    document.querySelectorAll('.provider-card').forEach(card => {
        card.addEventListener('click', function() {
            document.querySelectorAll('.provider-card').forEach(c => c.classList.remove('selected'));
            this.classList.add('selected');

            selectedProvider = {
                id: this.dataset.provider,
                payment: this.dataset.payment,
                name: this.dataset.name
            };

            document.getElementById('inputPaymentMethod').value = selectedProvider.payment;
            document.getElementById('inputProviderName').value = selectedProvider.name;

            // Reset
            selectedPlan = null;
            document.getElementById('confirmSection').classList.add('hidden');
            document.getElementById('morePlansSection').classList.add('hidden');

            // Show default selection
            document.getElementById('selectionSection').classList.remove('hidden');

            // Check combo availability
            const networkData = NETWORK_PLANS[selectedProvider.id];
            const hasCombo = networkData && networkData.comboPlans && networkData.comboPlans.length > 0;
            if (hasCombo) {
                document.getElementById('tabCombo').classList.remove('hidden');
            } else {
                document.getElementById('tabCombo').classList.add('hidden');
            }

            document.getElementById('selectionSection').scrollIntoView({ behavior: 'smooth', block: 'start' });
        });
    });

    // ========== "CONTINUE WITH THIS" BUTTON ==========
    document.getElementById('continueBtn').addEventListener('click', function() {
        if (!selectedProvider) return;

        // Use the default bundle
        selectedPlan = {
            gb: DEFAULT_BUNDLE.gb,
            price: DEFAULT_BUNDLE.price,
            type: 'default',
            label: DEFAULT_BUNDLE.name
        };

        document.getElementById('summaryProvider').textContent = selectedProvider.name;
        document.getElementById('summaryBundle').textContent = selectedPlan.label;
        document.getElementById('summaryTotal').textContent = 'TZS ' + selectedPlan.price.toLocaleString();

        document.getElementById('inputPlanGb').value = selectedPlan.gb;
        document.getElementById('inputPlanPrice').value = selectedPlan.price;
        document.getElementById('inputPlanType').value = 'default';
        document.getElementById('inputPlanLabel').value = selectedPlan.label;

        document.getElementById('confirmSection').classList.remove('hidden');
        document.getElementById('confirmSection').scrollIntoView({ behavior: 'smooth', block: 'center' });
    });

    // ========== "SEE MORE PLANS" BUTTON ==========
    document.getElementById('morePlansBtn').addEventListener('click', function() {
        document.getElementById('morePlansSection').classList.remove('hidden');
        currentPlanType = 'small';
        renderPlans();
        document.getElementById('morePlansSection').scrollIntoView({ behavior: 'smooth', block: 'start' });
    });

    // ========== TAB CLICKS ==========
    document.getElementById('tabSmall').addEventListener('click', function() {
        currentPlanType = 'small';
        renderPlans();
    });

    document.getElementById('tabData').addEventListener('click', function() {
        currentPlanType = 'data';
        renderPlans();
    });

    document.getElementById('tabCombo').addEventListener('click', function() {
        currentPlanType = 'combo';
        renderPlans();
    });

    // ========== RENDER PLANS ==========
    function renderPlans() {
        if (!selectedProvider) return;

        const networkData = NETWORK_PLANS[selectedProvider.id];
        if (!networkData) return;

        let plans, typeLabel;
        if (currentPlanType === 'small') {
            plans = networkData.smallPlans || [];
            typeLabel = 'Small Bundle';
        } else if (currentPlanType === 'combo') {
            plans = networkData.comboPlans || [];
            typeLabel = 'Combo Plan';
        } else {
            plans = networkData.dataPlans || [];
            typeLabel = 'Big Data Plan';
        }

        const planGrid = document.getElementById('planGrid');
        planGrid.innerHTML = '';

        document.getElementById('tabSmall').classList.toggle('active', currentPlanType === 'small');
        document.getElementById('tabData').classList.toggle('active', currentPlanType === 'data');
        document.getElementById('tabCombo').classList.toggle('active', currentPlanType === 'combo');

        if (!plans || plans.length === 0) {
            planGrid.innerHTML = '<div class="col-span-full text-center py-8 text-gray-400">No plans here</div>';
            return;
        }

        plans.forEach(function(plan) {
            const card = document.createElement('div');
            card.className = 'plan-card glass rounded-xl p-3 text-center cursor-pointer hover:bg-white/10 transition border-2 border-transparent';
            card.innerHTML = `
                <div class="text-xl font-bold text-blue-400">${plan.gb}GB</div>
                <div class="text-sm font-bold text-white mt-1">TZS ${plan.price.toLocaleString()}</div>
                ${plan.extra ? `<div class="text-xs text-purple-300 mt-1">${plan.extra}</div>` : ''}
                <div class="text-xs text-gray-400 mt-1">${plan.note || ''}</div>
            `;

            card.addEventListener('click', function() {
                document.querySelectorAll('.plan-card').forEach(p => p.classList.remove('selected'));
                this.classList.add('selected');

                selectedPlan = {
                    gb: plan.gb,
                    price: plan.price,
                    type: currentPlanType,
                    label: plan.extra || (plan.gb + 'GB ' + typeLabel)
                };

                document.getElementById('summaryProvider').textContent = selectedProvider.name;
                document.getElementById('summaryBundle').textContent = selectedPlan.label;
                document.getElementById('summaryTotal').textContent = 'TZS ' + selectedPlan.price.toLocaleString();

                document.getElementById('inputPlanGb').value = selectedPlan.gb;
                document.getElementById('inputPlanPrice').value = selectedPlan.price;
                document.getElementById('inputPlanType').value = currentPlanType;
                document.getElementById('inputPlanLabel').value = selectedPlan.label;

                document.getElementById('confirmSection').classList.remove('hidden');
                document.getElementById('confirmSection').scrollIntoView({ behavior: 'smooth', block: 'center' });
            });

            planGrid.appendChild(card);
        });
    }

    // ========== PREVENT DOUBLE SUBMIT ==========
    document.getElementById('paymentForm').addEventListener('submit', function() {
        const btn = document.getElementById('payBtn');
        btn.disabled = true;
        btn.textContent = '⏳ Processing...';
    });
});
</script>

<%- include('partials/footer') %>