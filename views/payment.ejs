            { gb: 3, price: 3600, note: '3GB Bundle' },
            { gb: 4, price: 4800, note: '4GB Bundle' },
            { gb: 5, price: 6000, note: '5GB Bundle' }
           
        ],
        dataPlans: [
            { gb: 15, price: 15000, note: 'Kila Mwezi' },
            { gb: 35, price: 30000, note: 'Kila Mwezi' },
            { gb: 48, price: 40000, note: 'Kila Mwezi' }
        ],
        comboPlans: [
            { gb: 10, price: 15000, note: 'Kila Mwezi', extra: 'GB 10 + DK 400' },
            { gb: 25, price: 30000, note: 'Kila Mwezi', extra: 'GB 25 + DK 1000' },
            { gb: 35, price: 40000, note: 'Kila Mwezi', extra: 'GB 35 + DK 2000' }
        ]
    },
    vodacom: {
        name: 'Vodacom',
        smallPlans: [
            { gb: 1, price: 1200, note: '1GB Bundle' },
            { gb: 2, price: 2400, note: '2GB Bundle' },
            { gb: 3, price: 3600, note: '3GB Bundle' },
            { gb: 4, price: 4800, note: '4GB Bundle' },
            { gb: 5, price: 6000, note: '5GB Bundle' }
           
        ],
        dataPlans: [
            { gb: 10,  price: 15000,  note: 'Siku 30' },
            { gb: 15,  price: 20000,  note: 'Siku 30' },
            { gb: 30,  price: 30000,  note: 'Siku 30' },
            { gb: 60,  price: 50000,  note: 'Siku 30' },
            { gb: 75,  price: 60000,  note: 'Siku 30' },
            { gb: 100, price: 75000,  note: 'Siku 30' },
            { gb: 150, price: 100000, note: 'Siku 30' }
        ],
        comboPlans: [
            { gb: 7,   price: 15000,  note: 'Siku 30', extra: 'GB 7 + DKK 500 + SMS 100' },
            { gb: 10,  price: 20000,  note: 'Siku 30', extra: 'GB 10 + DKK 1000 + SMS 100' },
            { gb: 20,  price: 30000,  note: 'Siku 30', extra: 'GB 20 + DKK 1500 + SMS 100' },
            { gb: 50,  price: 50000,  note: 'Siku 30', extra: 'GB 50 + DKK 2000 + SMS 100' },
            { gb: 60,  price: 60000,  note: 'Siku 30', extra: 'GB 60 + DKK 3000 + SMS 100' },
            { gb: 80,  price: 75000,  note: 'Siku 30', extra: 'GB 80 + DKK 5000 + SMS 100' },
            { gb: 120, price: 100000, note: 'Siku 30', extra: 'GB 120 + DKK 8000 + SMS 100' }
        ]
    },
    halotel: {
        name: 'Halotel',
        smallPlans: [
            { gb: 1, price: 1200, note: '1GB Bundle' },
            { gb: 2, price: 2400, note: '2GB Bundle' },
            { gb: 3, price: 3600, note: '3GB Bundle' },
            { gb: 4, price: 4800, note: '4GB Bundle' },
            { gb: 5, price: 6000, note: '5GB Bundle' }
           
        ],
        dataPlans: [
            { gb: 6,  price: 7000,  note: 'Internet Bundle' },
            { gb: 7,  price: 8000,  note: 'Internet Bundle' },
            { gb: 8,  price: 9000,  note: 'Internet Bundle' },
            { gb: 9,  price: 10000, note: 'Internet Bundle' },
            { gb: 10, price: 11000, note: 'Internet Bundle' },
            { gb: 11, price: 12000, note: 'Internet Bundle' },
            { gb: 12, price: 13000, note: 'Internet Bundle' },
            { gb: 13, price: 14000, note: 'Internet Bundle' },
            { gb: 14, price: 15000, note: 'Internet Bundle' },
            { gb: 15, price: 15000, note: 'Internet Bundle' },
            { gb: 16, price: 16000, note: 'Internet Bundle' },
            { gb: 17, price: 17000, note: 'Internet Bundle' },
            { gb: 18, price: 18000, note: 'Internet Bundle' },
            { gb: 19, price: 19000, note: 'Internet Bundle' },
            { gb: 20, price: 20000, note: 'Internet Bundle' },
            { gb: 25, price: 25000, note: 'Internet Bundle' },
            { gb: 30, price: 30000, note: 'Internet Bundle' }
        ],
        comboPlans: []
    },
    airtel: {
        name: 'Airtel',
        smallPlans: [
            { gb: 1, price: 1200, note: '1GB Bundle' },
            { gb: 2, price: 2400, note: '2GB Bundle' },
            { gb: 3, price: 3600, note: '3GB Bundle' },
            { gb: 4, price: 4800, note: '4GB Bundle' },
            { gb: 5, price: 6000, note: '5GB Bundle' }
           
        ],
        dataPlans: [
            { gb: 5,  price: 5000,  note: 'Data Bundle' },
            { gb: 10, price: 10000, note: 'Data Bundle' },
            { gb: 20, price: 20000, note: 'Data Bundle' },
            { gb: 30, price: 30000, note: 'Data Bundle' }
        ],
        comboPlans: []
    }
};

document.addEventListener('DOMContentLoaded', function() {
    let selectedProvider = null;
    let selectedPlan = null;
    let currentPlanType = 'data';

    // ========== PROVIDER CLICK ==========
    document.querySelectorAll('.provider-card').forEach(card => {
        card.addEventListener('click', function() {
            document.querySelectorAll('.provider-card').forEach(c => c.classList.remove('selected'));
            this.classList.add('selected');

            selectedProvider = {
                id: this.dataset.provider,
                payment: this.dataset.payment,
                name: this.dataset.name
            };

            // Reset
            selectedPlan = null;
            document.getElementById('confirmSection').classList.add('hidden');
            document.getElementById('inputPaymentMethod').value = selectedProvider.payment;
            document.getElementById('inputProviderName').value = selectedProvider.name;

            // Show plans
            document.getElementById('plansSection').classList.remove('hidden');

            // Check if this network has combo
            const networkData = NETWORK_PLANS[selectedProvider.id];
            const hasCombo = networkData && networkData.comboPlans && networkData.comboPlans.length > 0;

            if (hasCombo) {
                document.getElementById('tabCombo').classList.remove('hidden');
            } else {
                document.getElementById('tabCombo').classList.add('hidden');
            }

            currentPlanType = 'data';
            renderPlans();
            document.getElementById('plansSection').scrollIntoView({ behavior: 'smooth', block: 'start' });
        });
    });

    // ========== TAB CLICKS ==========
    document.getElementById('tabData').addEventListener('click', function() {
        currentPlanType = 'data';
        selectedPlan = null;
        document.getElementById('confirmSection').classList.add('hidden');
        renderPlans();
    });

    document.getElementById('tabCombo').addEventListener('click', function() {
        currentPlanType = 'combo';
        selectedPlan = null;
        document.getElementById('confirmSection').classList.add('hidden');
        renderPlans();
    });

   // ========== RENDER PLANS ==========
    function renderPlans() {
        if (!selectedProvider) return;

        const networkData = NETWORK_PLANS[selectedProvider.id];
        if (!networkData) {
            console.error('No data for provider:', selectedProvider.id);
            return;
        }

        // Pick the right plans based on tab
        let plans;
        let typeLabel;
        if (currentPlanType === 'small') {
            plans = networkData.smallPlans || [];
            typeLabel = '📱 Small Bundle';
        } else if (currentPlanType === 'combo') {
            plans = networkData.comboPlans || [];
            typeLabel = '🎁 Combo Plan';
        } else {
            plans = networkData.dataPlans || [];
            typeLabel = '📶 Data Plan';
        }

        const planGrid = document.getElementById('planGrid');
        planGrid.innerHTML = '';

        // Update tab styles
        document.getElementById('tabSmall').classList.toggle('active', currentPlanType === 'small');
        document.getElementById('tabData').classList.toggle('active', currentPlanType === 'data');
        document.getElementById('tabCombo').classList.toggle('active', currentPlanType === 'combo');

        if (!plans || plans.length === 0) {
            planGrid.innerHTML = '<div class="col-span-full text-center py-8 text-gray-400">No plans available in this category</div>';
            return;
        }

        plans.forEach(function(plan) {
            const card = document.createElement('div');
            card.className = 'plan-card glass rounded-xl p-3 text-center cursor-pointer hover:bg-white/10 transition border-2 border-transparent';
            card.innerHTML = `
                <div class="text-xl font-bold text-blue-400">${plan.gb}GB</div>
                <div class="text-sm font-bold text-white mt-1">TZS ${plan.price.toLocaleString()}</div>
                ${plan.extra ? `<div class="text-xs text-purple-300 mt-1">${plan.extra}</div>` : ''}
                <div class="text-xs text-gray-400 mt-1">${plan.note || ''}</div>
            `;

            card.addEventListener('click', function() {
                document.querySelectorAll('.plan-card').forEach(p => p.classList.remove('selected'));
                this.classList.add('selected');

                selectedPlan = {
                    gb: plan.gb,
                    price: plan.price,
                    type: currentPlanType,
                    label: plan.extra || `${plan.gb}GB ${typeLabel.replace(/[^a-zA-Z ]/g, '').trim()}`
                };

                document.getElementById('summaryProvider').textContent = selectedProvider.name;
                document.getElementById('summaryType').textContent = typeLabel;
                document.getElementById('summaryBundle').textContent = selectedPlan.label;
                document.getElementById('summaryTotal').textContent = 'TZS ' + selectedPlan.price.toLocaleString();

                document.getElementById('inputPlanGb').value = selectedPlan.gb;
                document.getElementById('inputPlanPrice').value = selectedPlan.price;
                document.getElementById('inputPlanType').value = currentPlanType;
                document.getElementById('inputPlanLabel').value = selectedPlan.label;

                document.getElementById('confirmSection').classList.remove('hidden');
                document.getElementById('confirmSection').scrollIntoView({ behavior: 'smooth', block: 'center' });
            });

            planGrid.appendChild(card);
        });
    }

    // ========== PREVENT DOUBLE SUBMIT ==========
    document.getElementById('paymentForm').addEventListener('submit', function() {
        const btn = document.getElementById('payBtn');
        btn.disabled = true;
        btn.textContent = '⏳ Processing...';
    });
});
</script>

<%- include('partials/footer') %>