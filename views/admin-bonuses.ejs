<%- include('partials/header') %>

<div class="max-w-6xl mx-auto px-4 py-8">
    <div class="flex justify-between items-center mb-6 flex-wrap gap-3">
        <h1 class="text-2xl font-bold text-white">
            🎁 <%= lang === 'sw' ? 'Usimamizi wa Bonasi' : 'Bonus Management' %>
        </h1>
        <a href="/admin" class="text-sm text-gray-400 hover:text-white transition">
            ← <%= lang === 'sw' ? 'Rudi Admin' : 'Back to Admin' %>
        </a>
    </div>

    <% if (typeof success !== 'undefined' && success === 'BonusSent') { %>
        <div class="bg-green-500/20 border border-green-500/30 text-green-300 p-4 rounded-xl mb-6">
            ✅ <%= lang === 'sw' ? 'Bonasi imetumwa kikamilifu!' : 'Bonus sent successfully!' %>
        </div>
    <% } %>
    <% if (typeof error !== 'undefined' && error) { %>
        <div class="bg-red-500/20 border border-red-500/30 text-red-300 p-4 rounded-xl mb-6">
            ❌ <%= error %>
        </div>
    <% } %>

    <!-- Eligibility Info -->
    <div class="glass rounded-2xl p-5 mb-6">
        <h2 class="text-lg font-bold text-white mb-2">📋 <%= lang === 'sw' ? 'Vigezo' : 'Eligibility Criteria' %></h2>
        <p class="text-sm text-gray-400">
            <%= lang === 'sw' 
                ? 'Wateja waliofanya manunuzi 5+ katika siku 7 zilizopita. Bonasi: 2GB (mara moja kwa wiki).'
                : 'Customers with 5+ completed transactions in the last 7 days. Bonus: 2GB (once per week).' %>
        </p>
    </div>

    <!-- Eligible Users -->
    <div class="glass rounded-2xl p-6 mb-6">
        <h2 class="text-xl font-bold text-white mb-4">
            👥 <%= lang === 'sw' ? 'Wanaostahili Bonasi' : 'Eligible Users' %>
            <span class="text-sm font-normal text-gray-400">(<%= eligible.length %>)</span>
        </h2>

        <% if (eligible.length === 0) { %>
            <div class="text-center py-8">
                <div class="text-5xl mb-3">✨</div>
                <p class="text-gray-400">
                    <%= lang === 'sw' 
                        ? 'Hakuna mteja anayestahili bonasi kwa sasa.'
                        : 'No eligible users at the moment.' %>
                </p>
                <p class="text-xs text-gray-500 mt-2">
                    <%= lang === 'sw' 
                        ? 'Wateja wanapofanya manunuzi 5+, wataonekana hapa.'
                        : 'When users make 5+ purchases, they\'ll show up here.' %>
                </p>
            </div>
        <% } else { %>
            <div class="overflow-x-auto">
                <table class="w-full text-sm">
                    <thead class="border-b border-white/10">
                        <tr class="text-left text-gray-400">
                            <th class="pb-3 px-2"><%= lang === 'sw' ? 'Jina' : 'Name' %></th>
                            <th class="pb-3 px-2"><%= lang === 'sw' ? 'Simu' : 'Phone' %></th>
                            <th class="pb-3 px-2 text-center"><%= lang === 'sw' ? 'Manunuzi (Wiki)' : 'Txns (Week)' %></th>
                            <th class="pb-3 px-2 text-right"><%= lang === 'sw' ? 'Alitumia' : 'Spent' %></th>
                            <th class="pb-3 px-2 text-center"><%= lang === 'sw' ? 'Bonasi ya Mwisho' : 'Last Bonus' %></th>
                            <th class="pb-3 px-2 text-center"><%= lang === 'sw' ? 'Hatua' : 'Action' %></th>
                        </tr>
                    </thead>
                    <tbody>
                        <% eligible.forEach(function(u) { %>
                            <tr class="border-b border-white/5 hover:bg-white/5 transition">
                                <td class="py-3 px-2 text-white"><%= u.fullname %></td>
                                <td class="py-3 px-2 text-white/80"><%= u.phone %></td>
                                <td class="py-3 px-2 text-center">
                                    <span class="px-3 py-1 rounded-full bg-blue-500/20 text-blue-300 font-bold text-xs">
                                        <%= u.transactionCount %>
                                    </span>
                                </td>
                                <td class="py-3 px-2 text-right text-green-400 font-semibold">
                                    TZS <%= u.totalSpent.toLocaleString() %>
                                </td>
                                <td class="py-3 px-2 text-center text-xs text-gray-400">
                                    <%= u.lastBonusDate ? new Date(u.lastBonusDate).toLocaleDateString('en-TZ') : '—' %>
                                </td>
                                <td class="py-3 px-2 text-center">
    <form action="/admin/send-bonus" method="POST" style="display:inline;" class="bonus-form">
        <input type="hidden" name="phone" value="<%= u.phone %>">
        <input type="hidden" name="fullname" value="<%= u.fullname %>">
        <button type="submit" 
                data-name="<%= u.fullname %>"
                class="confirm-bonus-btn px-4 py-2 bg-gradient-to-r from-yellow-500 to-orange-600 rounded-lg text-white text-xs font-semibold hover:scale-105 transition">
            🎁 <%= lang === 'sw' ? 'Tuma 2GB' : 'Send 2GB' %>
        </button>
    </form>
</td>
                            </tr>
                        <% }); %>
                    </tbody>
                </table>
            </div>
        <% } %>
    </div>

    <!-- Bonus History -->
    <div class="glass rounded-2xl p-6">
        <h2 class="text-xl font-bold text-white mb-4">
            📜 <%= lang === 'sw' ? 'Historia ya Bonasi' : 'Bonus History' %>
        </h2>
        <% if (bonusHistory.length === 0) { %>
            <p class="text-gray-400 text-center py-6 text-sm">
                <%= lang === 'sw' ? 'Hakuna bonasi zilizotumwa bado' : 'No bonuses sent yet' %>
            </p>
        <% } else { %>
            <div class="space-y-2">
                <% bonusHistory.forEach(function(b) { %>
                    <div class="border-b border-white/5 py-3 flex justify-between items-center">
                        <div>
                            <div class="text-white font-semibold text-sm"><%= b.fullname || b.phone %></div>
                            <div class="text-xs text-gray-400"><%= b.phone %></div>
                        </div>
                        <div class="text-right">
                            <div class="text-yellow-400 font-bold text-sm">🎁 <%= b.bundleName %></div>
                            <div class="text-xs text-gray-500"><%= new Date(b.date).toLocaleString('en-TZ') %></div>
                        </div>
                    </div>
                <% }); %>
            </div>
        <% } %>
    </div>
</div>
<script>
document.addEventListener('DOMContentLoaded', function() {
    const isSwahili = '<%= lang %>' === 'sw';
    
    document.querySelectorAll('.confirm-bonus-btn').forEach(function(btn) {
        btn.addEventListener('click', function(e) {
            const name = this.dataset.name;
            const msg = isSwahili 
                ? 'Tuma bonasi ya 2GB kwa ' + name + '?'
                : 'Send 2GB bonus to ' + name + '?';
            
            if (!confirm(msg)) {
                e.preventDefault();
                return false;
            }
        });
    });
});
</script>

<%- include('partials/footer') %>