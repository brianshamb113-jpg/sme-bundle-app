<%- include('partials/header') %>

<div class="max-w-2xl mx-auto px-4 py-12">
    <div class="glass rounded-2xl p-8 text-center">
        <div class="text-6xl mb-4">✅</div>
        <h1 class="text-3xl font-bold text-white mb-2">
            <%= lang === 'sw' ? 'Malipo Yamefanikiwa!' : 'Payment Successful!' %>
        </h1>
        <p class="text-gray-400 mb-6">
            <%= lang === 'sw' ? 'Bundle yako inachakatwa' : 'Your bundle is being processed' %>
        </p>

        <div class="bg-white/5 rounded-xl p-6 text-left mb-6">
            <div class="flex justify-between py-2 border-b border-white/10">
                <span class="text-gray-400"><%= lang === 'sw' ? 'Bundle' : 'Bundle' %>:</span>
                <span class="text-white font-semibold"><%= bundle.name %></span>
            </div>
            <div class="flex justify-between py-2 border-b border-white/10">
                <span class="text-gray-400"><%= lang === 'sw' ? 'Kiasi' : 'Amount' %>:</span>
                <span class="text-green-400 font-semibold">TZS <%= bundle.price.toLocaleString() %></span>
            </div>
            <div class="flex justify-between py-2 border-b border-white/10">
                <span class="text-gray-400"><%= lang === 'sw' ? 'Njia' : 'Method' %>:</span>
                <span class="text-white"><%= transaction.paymentMethod %></span>
            </div>
            <div class="flex justify-between py-2 border-b border-white/10">
                <span class="text-gray-400"><%= lang === 'sw' ? 'Simu' : 'Phone' %>:</span>
                <span class="text-white"><%= phoneNumber %></span>
            </div>
            <div class="flex justify-between py-2 border-b border-white/10">
                <span class="text-gray-400">ID:</span>
                <span class="text-white text-sm"><%= transaction.id %></span>
            </div>
            <div class="flex justify-between py-2">
                <span class="text-gray-400"><%= lang === 'sw' ? 'Hali' : 'Status' %>:</span>
                <span class="text-green-400 font-semibold">✅ <%= lang === 'sw' ? 'Imekamilika' : 'Completed' %></span>
            </div>
        </div>

        <div class="bg-blue-500/20 border border-blue-500/30 rounded-xl p-4 mb-6 text-left">
            <strong class="text-blue-300">📱 <%= lang === 'sw' ? 'Utumaji wa Bundle' : 'Bundle Delivery' %>:</strong>
            <p class="text-gray-300 text-sm mt-2">
                <%= lang === 'sw' 
                    ? 'Bundle yako ya ' + bundle.name + ' itatumwa kwa ' + phoneNumber + ' ndani ya dakika 2-5.'
                    : 'Your ' + bundle.name + ' will be sent to ' + phoneNumber + ' within 2-5 minutes.' %>
            </p>
        </div>

        <a href="/dashboard" class="inline-block px-8 py-3 bg-gradient-to-r from-blue-500 to-purple-600 rounded-xl font-semibold text-white hover:scale-105 transition">
            📊 <%= lang === 'sw' ? 'Rudi Dashibodi' : 'Back to Dashboard' %>
        </a>
    </div>
</div>

<%- include('partials/footer') %>