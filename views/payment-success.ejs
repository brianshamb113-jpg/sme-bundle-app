<!DOCTYPE html>
<html lang="<%= lang === 'sw' ? 'sw' : 'en' %>">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>SME Bundles Tanzania</title>
    <!-- Use Tailwind CDN (no build step needed!) -->
    <script src="https://cdn.tailwindcss.com"></script>
    <script>
    // Language toggle via fetch (no page reload needed)
    function toggleLanguage() {
        fetch('/toggle-language')
            .then(response => {
                // After toggling, reload the page to show the new language
                window.location.reload();
            })
            .catch(error => {
                console.error('Language toggle failed:', error);
                // Fallback: just reload the page
                window.location.reload();
            });
    }
</script>
    <style>
        * { margin: 0; padding: 0; box-sizing: border-box; }
        body { font-family: Arial, sans-serif; background: #f5f5f5; display: flex; justify-content: center; align-items: center; min-height: 100vh; }
        .success-box { background: white; padding: 50px; border-radius: 10px; box-shadow: 0 2px 30px rgba(0,0,0,0.1); max-width: 500px; width: 100%; text-align: center; }
        .checkmark { font-size: 4em; color: #2e7d32; }
        h1 { color: #1a237e; margin: 20px 0; }
        .details { background: #f5f5f5; padding: 20px; border-radius: 8px; margin: 20px 0; text-align: left; }
        .details p { padding: 5px 0; border-bottom: 1px solid #e0e0e0; }
        .details p:last-child { border-bottom: none; }
        .details strong { color: #1a237e; }
        .btn { display: inline-block; padding: 12px 30px; background: #1a237e; color: white; text-decoration: none; border-radius: 5px; font-weight: bold; margin-top: 20px; }
        .btn:hover { background: #0d47a1; }
        .delivery-note { background: #fff3e0; padding: 15px; border-radius: 8px; margin: 15px 0; border-left: 4px solid #ff9800; }
        .delivery-note strong { color: #e65100; }
    </style>
</head>
<body>
    <div class="success-box">
        <div class="checkmark">✅</div>
        <h1>Payment Successful!</h1>
        <p style="color:#666; font-size:1.1em;">Your bundle is being processed</p>
        
        <div class="details">
            <p><strong>Bundle:</strong> <%= bundle.name %></p>
            <p><strong>Amount:</strong> TZS <%= bundle.price.toLocaleString() %></p>
            <p><strong>Payment Method:</strong> <%= transaction.paymentMethod %></p>
            <p><strong>Phone Number:</strong> <%= phoneNumber %></p>
            <p><strong>Transaction ID:</strong> <%= transaction.id %></p>
            <p><strong>Confirmation Code:</strong> <%= transaction.confirmationCode %></p>
            <p><strong>Status:</strong> ✅ Completed</p>
        </div>
        
        <div class="delivery-note">
            <strong>📱 Bundle Delivery:</strong> Your <%= bundle.name %> will be sent to <strong><%= phoneNumber %></strong> within 2-5 minutes.
            <br><br>
            <small>📌 Note: In this demo version, bundle delivery is simulated. In the real app, it will be automatic via your SIM card!</small>
        </div>
        
       <div class="flex items-center space-x-4">
    <!-- Language Toggle -->
    <a href="/toggle-language" class="text-white/80 hover:text-white transition text-sm">
        <%= lang === 'sw' ? '🇬🇧 English' : '🇹🇿 Kiswahili' %>
    </a>
    <a href="/dashboard" class="text-white/80 hover:text-white transition text-sm">
        <%= lang === 'sw' ? 'Dashibodi' : 'Dashboard' %>
    </a>
</div>
        <br><br>
        <a href="/" style="color:#666; font-size:0.9em;">🏠 Homepage</a>
    </div>
</body>
</html>