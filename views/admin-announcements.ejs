<%- include('partials/header') %>

<div class="max-w-4xl mx-auto px-4 py-8">
    <div class="flex justify-between items-center mb-6 flex-wrap gap-3">
        <h1 class="text-2xl font-bold text-white">📢 <%= lang === 'sw' ? 'Matangazo' : 'Announcements' %></h1>
        <a href="/admin" class="text-sm text-gray-400 hover:text-white transition">
            ← <%= lang === 'sw' ? 'Rudi Admin' : 'Back to Admin' %>
        </a>
    </div>

    <% if (typeof success !== 'undefined' && success) { %>
        <div class="bg-green-500/20 border border-green-500/30 text-green-300 p-3 rounded-xl mb-4">
            ✅ <%= success %>
        </div>
    <% } %>
    <% if (typeof error !== 'undefined' && error) { %>
        <div class="bg-red-500/20 border border-red-500/30 text-red-300 p-3 rounded-xl mb-4">
            ❌ <%= error %>
        </div>
    <% } %>

    <!-- Create Announcement -->
    <div class="glass rounded-2xl p-6 mb-6">
        <h2 class="text-lg font-bold text-white mb-4">✍️ <%= lang === 'sw' ? 'Tengeneza Tangazo Jipya' : 'Create New Announcement' %></h2>

        <form action="/admin/announcements/create" method="POST">
            <div class="mb-4">
                <label class="block text-white text-sm font-semibold mb-2"><%= lang === 'sw' ? 'Kichwa' : 'Title' %></label>
                <input type="text" name="title" required maxlength="100"
                       placeholder="<%= lang === 'sw' ? 'Mfano: Punguzo la Wiki Hii' : 'e.g., Special Discount This Week' %>"
                       class="w-full px-4 py-3 bg-white/10 border border-white/20 rounded-xl text-white placeholder-gray-400 focus:outline-none focus:ring-2 focus:ring-blue-500">
            </div>

            <div class="mb-4">
                <label class="block text-white text-sm font-semibold mb-2"><%= lang === 'sw' ? 'Ujumbe' : 'Message' %></label>
                <textarea name="message" required rows="4" maxlength="500"
                          placeholder="<%= lang === 'sw' ? 'Andika ujumbe wako hapa...' : 'Write your message here...' %>"
                          class="w-full px-4 py-3 bg-white/10 border border-white/20 rounded-xl text-white placeholder-gray-400 focus:outline-none focus:ring-2 focus:ring-blue-500"></textarea>
            </div>

            <div class="mb-4">
                <label class="block text-white text-sm font-semibold mb-2"><%= lang === 'sw' ? 'Aina' : 'Type' %></label>
                <select name="type" class="w-full px-4 py-3 bg-white/10 border border-white/20 rounded-xl text-white focus:outline-none focus:ring-2 focus:ring-blue-500">
                    <option value="info" class="bg-gray-800">📘 Info</option>
                    <option value="success" class="bg-gray-800">✅ Success</option>
                    <option value="warning" class="bg-gray-800">⚠️ Warning</option>
                </select>
            </div>

            <button type="submit" class="w-full py-3 bg-gradient-to-r from-blue-500 to-purple-600 rounded-xl font-semibold text-white hover:scale-105 transition">
                📢 <%= lang === 'sw' ? 'Tangaza' : 'Publish' %>
            </button>
        </form>
    </div>

    <!-- Existing Announcements -->
    <div class="glass rounded-2xl p-6">
        <h2 class="text-lg font-bold text-white mb-4">
            📋 <%= lang === 'sw' ? 'Matangazo Yaliyopo' : 'Existing Announcements' %>
            <span class="text-sm text-gray-400">(<%= announcements.length %>)</span>
        </h2>

        <% if (announcements.length === 0) { %>
            <p class="text-gray-400 text-center py-6 text-sm">
                <%= lang === 'sw' ? 'Hakuna matangazo bado' : 'No announcements yet' %>
            </p>
        <% } else { %>
            <div class="space-y-3">
                <% announcements.forEach(function(a) { %>
                    <div class="border border-white/10 rounded-xl p-4 <%= a.active ? '' : 'opacity-50' %>">
                        <div class="flex justify-between items-start gap-3 mb-2">
                            <div class="flex-1">
                                <div class="flex items-center gap-2">
                                    <span class="text-lg">
                                        <%= a.type === 'success' ? '✅' : a.type === 'warning' ? '⚠️' : '📘' %>
                                    </span>
                                    <strong class="text-white"><%= a.title %></strong>
                                    <% if (!a.active) { %>
                                        <span class="px-2 py-0.5 text-xs bg-gray-500/30 text-gray-400 rounded-full">
                                            <%= lang === 'sw' ? 'Imezimwa' : 'Inactive' %>
                                        </span>
                                    <% } %>
                                </div>
                                <p class="text-gray-400 text-sm mt-2"><%= a.message %></p>
                                <p class="text-xs text-gray-500 mt-2">
                                    <%= new Date(a.createdAt).toLocaleString('en-TZ') %>
                                </p>
                            </div>
                        </div>

                        <div class="flex gap-2 mt-3">
                            <form action="/admin/announcements/toggle/<%= a._id %>" method="POST" style="display:inline;">
                                <button type="submit" class="px-3 py-1.5 text-xs bg-blue-500/20 border border-blue-500/30 rounded-lg text-blue-300 hover:bg-blue-500/30 transition">
                                    <%= a.active ? '⏸️ ' + (lang === 'sw' ? 'Zima' : 'Deactivate') : '▶️ ' + (lang === 'sw' ? 'Washa' : 'Activate') %>
                                </button>
                            </form>
                            <form action="/admin/announcements/delete/<%= a._id %>" method="POST" style="display:inline;" class="delete-form">
                                <button type="submit" class="px-3 py-1.5 text-xs bg-red-500/20 border border-red-500/30 rounded-lg text-red-300 hover:bg-red-500/30 transition">
                                    🗑️ <%= lang === 'sw' ? 'Futa' : 'Delete' %>
                                </button>
                            </form>
                        </div>
                    </div>
                <% }); %>
            </div>
        <% } %>
    </div>
</div>

<script>
document.addEventListener('DOMContentLoaded', function() {
    document.querySelectorAll('.delete-form').forEach(function(form) {
        form.addEventListener('submit', function(e) {
            if (!confirm('<%= lang === "sw" ? "Futa tangazo hili?" : "Delete this announcement?" %>')) {
                e.preventDefault();
            }
        });
    });
});
</script>

<%- include('partials/footer') %>