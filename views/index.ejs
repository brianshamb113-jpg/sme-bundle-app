<%- include('partials/header') %>

<!-- Hero Section -->
<section class="relative min-h-[70vh] flex items-center justify-center px-4">
    <div class="relative z-10 max-w-4xl text-center">
        <div class="glass inline-block px-6 py-2 rounded-full text-sm font-medium text-blue-300 mb-6">
            ⚡ <%= lang === 'sw' ? 'Bidhaa Mpya Tanzania' : 'New in Tanzania' %>
        </div>
        <h1 class="text-4xl md:text-6xl lg:text-7xl font-extrabold leading-tight text-white">
            <%= lang === 'sw' ? 'Nunua SME Bundles' : 'Buy SME Bundles' %><br>
            <span class="gradient-text">
                <%= lang === 'sw' ? 'Papara na Moja kwa Moja' : 'Instantly & Automatically' %>
            </span>
        </h1>
        <p class="text-lg md:text-xl text-gray-300 max-w-2xl mx-auto mt-6">
            <%= lang === 'sw' 
                ? 'Pata data bundles kwa punguzo la hadi 50%. Hakuna mawakala, hakuna kuchelewa — utumaji wa papara kwenye simu yako.'
                : 'Get data bundles at up to 50% discount. No agents, no delays — instant delivery to your phone.' %>
        </p>
        <div class="flex flex-col sm:flex-row gap-4 justify-center mt-10">
            <% if (!user) { %>
                <a href="/register" class="px-8 py-4 bg-gradient-to-r from-blue-500 to-purple-600 rounded-full font-semibold text-white hover:scale-105 transition glow">
                    🚀 <%= lang === 'sw' ? 'Anza Sasa' : 'Get Started' %>
                </a>
                <a href="#bundles" class="px-8 py-4 glass rounded-full font-semibold text-white hover:bg-white/10 transition">
                    <%= lang === 'sw' ? 'Tazama Bundles →' : 'View Bundles →' %>
                </a>
            <% } else { %>
                <a href="/dashboard" class="px-8 py-4 bg-gradient-to-r from-blue-500 to-purple-600 rounded-full font-semibold text-white hover:scale-105 transition glow">
                    📱 <%= lang === 'sw' ? 'Nenda Dashibodi' : 'Go to Dashboard' %>
                </a>
            <% } %>
        </div>
    </div>
</section>

<!-- Bundles Section -->
<section id="bundles" class="relative py-16 px-4">
    <div class="max-w-6xl mx-auto">
        <h2 class="text-3xl md:text-4xl font-bold text-center mb-4 text-white">
            🔥 <span class="gradient-text"><%= lang === 'sw' ? 'Bundles Zilizopo' : 'Available Bundles' %></span>
        </h2>
        <p class="text-gray-400 text-center mb-12">
            <%= lang === 'sw' ? 'Chagua bundle yako na upate utumaji wa papara' : 'Choose your bundle and get instant delivery' %>
        </p>

        <div class="grid grid-cols-1 md:grid-cols-3 lg:grid-cols-5 gap-4">
            <% bundles.forEach(function(bundle, index) { %>
                <div class="glass rounded-2xl p-6 text-center hover:scale-105 transition hover:glow">
                    <div class="text-3xl mb-3">
                        <%= bundle.data === '1GB' ? '📱' : bundle.data === '2GB' ? '📶' : bundle.data === '5GB' ? '🚀' : '⚡' %>
                    </div>
                    <h3 class="text-lg font-bold text-white"><%= bundle.name %></h3>
                    <div class="text-2xl font-bold text-blue-400 my-2">
                        TZS <%= bundle.price.toLocaleString() %>
                    </div>
                    <div class="text-xs text-gray-400 line-through">
                        <%= bundle.originalPrice.toLocaleString() %>
                    </div>
                    <div class="text-green-400 font-semibold text-xs mt-1">
                        💚 <%= lang === 'sw' ? 'Okoa' : 'Save' %> <%= (bundle.originalPrice - bundle.price).toLocaleString() %>
                    </div>
                    <a href="<%= user ? '/dashboard' : '/register' %>" class="block w-full mt-4 py-2 bg-gradient-to-r from-blue-500 to-purple-600 rounded-full font-semibold text-white text-sm hover:scale-105 transition">
                        <%= lang === 'sw' ? 'Nunua' : 'Buy' %>
                    </a>
                </div>
            <% }); %>
        </div>
    </div>
</section>

<!-- Features -->
<section class="py-16 px-4">
    <div class="max-w-6xl mx-auto">
        <div class="grid grid-cols-2 md:grid-cols-4 gap-4">
            <div class="glass rounded-xl p-6 text-center">
                <div class="text-4xl mb-3">⚡</div>
                <h3 class="font-bold text-white text-sm"><%= lang === 'sw' ? 'Papara' : 'Instant' %></h3>
                <p class="text-xs text-gray-400"><%= lang === 'sw' ? 'Utumaji wa sekunde' : 'Delivery in seconds' %></p>
            </div>
            <div class="glass rounded-xl p-6 text-center">
                <div class="text-4xl mb-3">💰</div>
                <h3 class="font-bold text-white text-sm"><%= lang === 'sw' ? 'Bei Nzuri' : 'Best Prices' %></h3>
                <p class="text-xs text-gray-400"><%= lang === 'sw' ? 'Okoa hadi 50%' : 'Save up to 50%' %></p>
            </div>
            <div class="glass rounded-xl p-6 text-center">
                <div class="text-4xl mb-3">🏆</div>
                <h3 class="font-bold text-white text-sm"><%= lang === 'sw' ? 'Zawadi' : 'Rewards' %></h3>
                <p class="text-xs text-gray-400"><%= lang === 'sw' ? 'Bonasi 2000 TZS' : '2000 TZS bonus' %></p>
            </div>
            <div class="glass rounded-xl p-6 text-center">
                <div class="text-4xl mb-3">🛡️</div>
                <h3 class="font-bold text-white text-sm"><%= lang === 'sw' ? 'Salama' : 'Secure' %></h3>
                <p class="text-xs text-gray-400"><%= lang === 'sw' ? 'Manunuzi salama' : 'Safe transactions' %></p>
            </div>
        </div>
    </div>
</section>

<%- include('partials/footer') %>