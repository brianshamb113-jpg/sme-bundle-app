<!DOCTYPE html>
<html lang="<%= lang === 'sw' ? 'sw' : 'en' %>">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>SME Bundles Tanzania</title>
    <!-- Google Fonts -->
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700;800&display=swap" rel="stylesheet">
    <!-- Tailwind CDN -->
    <script src="https://cdn.tailwindcss.com"></script>
    <script>
    document.addEventListener('DOMContentLoaded', function() {
        const cards = document.querySelectorAll('.bundle-card');
        cards.forEach((card, index) => {
            const delay = parseFloat(card.dataset.delay);
            card.style.animation = `reveal 0.8s cubic-bezier(0.2, 0, 0, 1) forwards`;
            card.style.animationDelay = delay + 's';
        });
    });
</script>
<script>
    // Language toggle via fetch (no page reload needed)
    function toggleLanguage() {
        fetch('/toggle-language')
            .then(response => {
                // After toggling, reload the page to show the new language
                window.location.reload();
            })
            .catch(error => {
                console.error('Language toggle failed:', error);
                // Fallback: just reload the page
                window.location.reload();
            });
    }
</script>
    <style>
        * {
            font-family: 'Inter', sans-serif;
        }
        /* Glassmorphism effect */
        .glass {
            background: rgba(255, 255, 255, 0.05);
            backdrop-filter: blur(12px);
            border: 1px solid rgba(255, 255, 255, 0.12);
        }
        .glass-dark {
            background: rgba(0, 0, 0, 0.4);
            backdrop-filter: blur(16px);
            border: 1px solid rgba(255, 255, 255, 0.08);
        }
        /* Gradient text */
        .gradient-text {
    background: linear-gradient(135deg, #60a5fa, #a78bfa, #f472b6);
    -webkit-background-clip: text;
    background-clip: text;  /* Add this line */
    -webkit-text-fill-color: transparent;
}
        /* Glow effect */
        .glow {
            box-shadow: 0 0 40px rgba(96, 165, 250, 0.15);
        }
        .glow:hover {
            box-shadow: 0 0 60px rgba(96, 165, 250, 0.3);
        }
        /* Animated gradient background */
        .animated-bg {
            background: linear-gradient(-45deg, #0a0a1a, #1a1a3e, #0d1b2a, #1a0a2e);
            background-size: 400% 400%;
            animation: gradient 15s ease infinite;
        }
        @keyframes gradient {
            0% { background-position: 0% 50%; }
            50% { background-position: 100% 50%; }
            100% { background-position: 0% 50%; }
        }
        /* Reveal animations */
        .reveal {
            opacity: 0;
            transform: translateY(30px);
            animation: reveal 0.8s cubic-bezier(0.2, 0, 0, 1) forwards;
        }
        .reveal-delay-1 { animation-delay: 0.1s; }
        .reveal-delay-2 { animation-delay: 0.3s; }
        .reveal-delay-3 { animation-delay: 0.5s; }
        .reveal-delay-4 { animation-delay: 0.7s; }
        .reveal-delay-5 { animation-delay: 0.9s; }
        @keyframes reveal {
            to { opacity: 1; transform: translateY(0); }
        }
        /* Floating particles effect */
        .particle {
            position: fixed;
            border-radius: 50%;
            background: rgba(96, 165, 250, 0.1);
            pointer-events: none;
            animation: float 20s infinite;
        }
        @keyframes float {
            0%, 100% { transform: translate(0, 0) scale(1); }
            25% { transform: translate(100px, -50px) scale(1.2); }
            50% { transform: translate(-50px, 100px) scale(0.8); }
            75% { transform: translate(50px, -100px) scale(1.1); }
        }
    </style>
</head>
<body class="bg-gray-50">
    <!-- Navigation -->
    <nav class="bg-indigo-900 text-white shadow-lg">
        <!-- In the navigation section -->
<div class="flex items-center space-x-4">
    <!-- LANGUAGE TOGGLE - Fixed version -->
    <a href="#" onclick="toggleLanguage(); return false;" class="text-sm text-white/80 hover:text-white transition">
        <%= locals.lang === 'sw' ? '🇬🇧 English' : '🇹🇿 Kiswahili' %>
    </a>
    <button onclick="toggleTheme()" class="theme-toggle text-2xl" id="themeIcon">🌙</button>
    <% if (user) { %>
        <a href="/dashboard" class="text-white/80 hover:text-white transition text-sm">
            <%= locals.lang === 'sw' ? 'Dashibodi' : 'Dashboard' %>
        </a>
        <a href="/logout" class="px-4 py-2 bg-gradient-to-r from-blue-500 to-purple-600 rounded-full text-white text-sm font-semibold hover:scale-105 transition">
            <%= locals.lang === 'sw' ? 'Toka' : 'Logout' %>
        </a>
    <% } else { %>
        <a href="/login" class="text-white/80 hover:text-white transition text-sm">
            <%= locals.lang === 'sw' ? 'Ingia' : 'Login' %>
        </a>
        <a href="/register" class="px-4 py-2 bg-gradient-to-r from-blue-500 to-purple-600 rounded-full text-white text-sm font-semibold hover:scale-105 transition">
            <%= locals.lang === 'sw' ? 'Jisajili' : 'Register' %>
        </a>
    <% } %>
</div>
</div>
    </nav>

<!-- Your page content goes here -->
<section class="relative min-h-[70vh] flex items-center justify-center px-4">
    <div class="relative z-10 max-w-4xl text-center">
        <div class="glass inline-block px-6 py-2 rounded-full text-sm font-medium text-blue-300 mb-6">
            ⚡ 10,000+ Bundles Sold
        </div>
        <h1 class="text-4xl md:text-6xl font-extrabold leading-tight">
            <%= locals.lang === 'sw' ? 'Nunua SME Bundles' : 'Buy SME Bundles' %><br>
            <span class="gradient-text"><%= locals.lang === 'sw' ? 'Papara na Moja kwa Moja' : 'Instantly & Automatically' %></span>
        </h1>
        <p class="text-lg text-gray-300 max-w-2xl mx-auto mt-6">
            <%= locals.lang === 'sw' ? 
                'Pata SME data bundles za Halotel kwa punguzo la hadi 50%. Hakuna mawakala, hakuna kuchelewa.' :
                'Get Halotel SME data bundles at up to 50% discount. No agents, no delays.' %>
        </p>
        <div class="flex flex-col sm:flex-row gap-4 justify-center mt-10">
            <% if (!user) { %>
                <a href="/register" class="px-8 py-4 bg-gradient-to-r from-blue-500 to-purple-600 rounded-full font-semibold text-white hover:scale-105 transition glow">
                    🚀 <%= locals.lang === 'sw' ? 'Anza Sasa' : 'Get Started' %>
                </a>
            <% } else { %>
                <a href="/dashboard" class="px-8 py-4 bg-gradient-to-r from-blue-500 to-purple-600 rounded-full font-semibold text-white hover:scale-105 transition glow">
                    📱 <%= locals.lang === 'sw' ? 'Nenda Dashibodi' : 'Go to Dashboard' %>
                </a>
            <% } %>
        </div>
    </div>
</section>

<!-- ... rest of your bundle section ... -->


   <!-- Hero Section -->
<section class="relative min-h-screen flex items-center justify-center px-4 overflow-hidden">
    <!-- Floating particles -->
    <div class="particle" style="width:300px;height:300px;top:10%;left:5%;animation-duration:25s;"></div>
    <div class="particle" style="width:200px;height:200px;bottom:20%;right:10%;animation-duration:20s;"></div>
    <div class="particle" style="width:150px;height:150px;top:50%;left:50%;animation-duration:30s;"></div>

    <div class="relative z-10 max-w-4xl text-center">
        <!-- Badge -->
        <div class="glass inline-block px-6 py-2 rounded-full text-sm font-medium text-blue-300 mb-6 reveal reveal-delay-1">
            ⚡ 10,000+ Bundles Sold
        </div>

        <!-- Main Heading -->
        <h1 class="text-4xl md:text-6xl lg:text-7xl font-extrabold leading-tight reveal reveal-delay-2">
            Buy SME Bundles<br>
            <span class="gradient-text">Instantly & Automatically</span>
        </h1>

        <!-- Sub-text -->
        <p class="text-lg md:text-xl text-gray-300 max-w-2xl mx-auto mt-6 reveal reveal-delay-3">
            Get Halotel SME data bundles at up to <span class="text-blue-400 font-bold">50% discount</span>.
            No agents, no delays — instant delivery to your phone.
        </p>

        <!-- CTA Buttons -->
        <div class="flex flex-col sm:flex-row gap-4 justify-center mt-10 reveal reveal-delay-4">
            <% if (!user) { %>
                <a href="/register" class="px-8 py-4 bg-gradient-to-r from-blue-500 to-purple-600 rounded-full font-semibold text-white hover:scale-105 transition duration-300 glow">
                    🚀 Get Started
                </a>
                <a href="#bundles" class="px-8 py-4 glass rounded-full font-semibold text-white hover:bg-white/10 transition duration-300">
                    View Bundles →
                </a>
            <% } else { %>
                <a href="/dashboard" class="px-8 py-4 bg-gradient-to-r from-blue-500 to-purple-600 rounded-full font-semibold text-white hover:scale-105 transition duration-300 glow">
                    📱 Go to Dashboard
                </a>
            <% } %>
        </div>

        <!-- Stats -->
        <div class="grid grid-cols-3 gap-8 max-w-2xl mx-auto mt-16 reveal reveal-delay-5">
            <div>
                <div class="text-3xl font-bold text-blue-400">10K+</div>
                <div class="text-sm text-gray-400">Transactions</div>
            </div>
            <div>
                <div class="text-3xl font-bold text-purple-400">50%</div>
                <div class="text-sm text-gray-400">Average Savings</div>
            </div>
            <div>
                <div class="text-3xl font-bold text-pink-400">99.9%</div>
                <div class="text-sm text-gray-400">Uptime</div>
            </div>
        </div>
    </div>
</section>

<!-- Bundles Section -->
<section id="bundles" class="relative py-20 px-4">
    <div class="max-w-6xl mx-auto">
        <h2 class="text-3xl md:text-4xl font-bold text-center mb-4">
            🔥 <span class="gradient-text">Available Bundles</span>
        </h2>
        <p class="text-gray-400 text-center mb-12">Choose your bundle and get instant delivery</p>

        <div class="grid grid-cols-1 md:grid-cols-3 gap-6" id="bundleContainer">
            <% bundles.forEach((bundle, index) => { %>
                <div class="glass rounded-2xl p-8 text-center hover:scale-105 transition duration-300 hover:glow bundle-card" data-delay="<%= index * 0.15 %>">
                    <div class="text-4xl mb-4">
                        <%= bundle.data === '1GB' ? '📱' : bundle.data === '2GB' ? '📶' : '🚀' %>
                    </div>
                    <h3 class="text-xl font-bold text-white"><%= bundle.name %></h3>
                    <div class="text-4xl font-bold text-blue-400 my-4">
                        TZS <%= bundle.price.toLocaleString() %>
                    </div>
                    <div class="text-sm text-gray-400 line-through">
                        Original: TZS <%= bundle.originalPrice.toLocaleString() %>
                    </div>
                    <div class="text-green-400 font-semibold mt-2">
                        💚 Save TZS <%= (bundle.originalPrice - bundle.price).toLocaleString() %>
                    </div>
                    <% if (user) { %>
                        <form action="/buy" method="POST" class="mt-6">
                            <input type="hidden" name="bundleId" value="<%= bundle.id %>">
                            <button type="submit" class="w-full py-3 bg-gradient-to-r from-blue-500 to-purple-600 rounded-full font-semibold text-white hover:scale-105 transition duration-300">
                                Buy Now
                            </button>
                        </form>
                    <% } else { %>
                        <a href="/register" class="block w-full py-3 bg-gradient-to-r from-blue-500 to-purple-600 rounded-full font-semibold text-white hover:scale-105 transition duration-300 text-center">
                            Buy Now
                        </a>
                    <% } %>
                </div>
            <% }); %>
        </div>
    </div>
</section>

    <!-- Features -->
    <section class="bg-gray-100 py-16">
        <div class="container mx-auto px-4">
            <div class="grid grid-cols-1 md:grid-cols-4 gap-8 max-w-5xl mx-auto">
                <div class="text-center">
                    <div class="text-4xl mb-3">⚡</div>
                    <h3 class="font-bold text-lg">Instant Delivery</h3>
                    <p class="text-gray-600">Get your bundle within seconds</p>
                </div>
                <div class="text-center">
                    <div class="text-4xl mb-3">💰</div>
                    <h3 class="font-bold text-lg">Best Prices</h3>
                    <p class="text-gray-600">Save up to 50% on SME bundles</p>
                </div>
                <div class="text-center">
                    <div class="text-4xl mb-3">🏆</div>
                    <h3 class="font-bold text-lg">Weekly Rewards</h3>
                    <p class="text-gray-600">Earn 2000 TZS bonus weekly</p>
                </div>
                <div class="text-center">
                    <div class="text-4xl mb-3">🛡️</div>
                    <h3 class="font-bold text-lg">Secure</h3>
                    <p class="text-gray-600">Safe and trusted transactions</p>
                </div>
            </div>
        </div>
    </section>

    <!-- Footer -->
    <footer class="bg-indigo-900 text-white py-8">
        <div class="container mx-auto px-4 text-center">
            <p>copy; 2026 SME Bundles Tanzania. Made with ❤️ in Tanzania 🇹🇿</p>
        </div>
    </footer>
</body>
</html>