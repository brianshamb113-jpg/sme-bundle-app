<%- include('partials/header') %>

<div class="max-w-2xl mx-auto px-4 py-12 text-center">
    <div class="text-6xl mb-4">📲</div>
    <h1 class="text-3xl font-bold text-white mb-4">
        <%= lang === 'sw' ? 'Pakua Programu' : 'Download the App' %>
    </h1>
    <p class="text-gray-400 mb-8">
        <%= lang === 'sw' 
            ? 'Pakua programu yetu kwenye simu yako na uanze kununua bundles kwa urahisi zaidi.' 
            : 'Download our app to your phone and start buying bundles with even more convenience.' %>
    </p>
    
    <a href="/downloads/sme-bundles.apk" 
       class="inline-block px-8 py-4 bg-gradient-to-r from-blue-500 to-purple-600 rounded-full font-bold text-white hover:scale-105 transition glow"
       download>
        ⬇️ <%= lang === 'sw' ? 'Pakua APK' : 'Download APK' %>
    </a>
    
    <div class="glass rounded-2xl p-6 mt-8 text-left">
        <h3 class="font-bold text-white mb-3">
            📋 <%= lang === 'sw' ? 'Jinsi ya Kufunga' : 'How to Install' %>
        </h3>
        <ol class="text-gray-400 space-y-2 text-sm">
            <li>1. <%= lang === 'sw' ? 'Pakua faili la APK' : 'Download the APK file' %></li>
            <li>2. <%= lang === 'sw' ? 'Fungua faili kwenye simu yako' : 'Open the file on your phone' %></li>
            <li>3. <%= lang === 'sw' ? 'Ruhusu "Install from unknown sources" kama inahitajika' : 'Allow "Install from unknown sources" if asked' %></li>
            <li>4. <%= lang === 'sw' ? 'Bonyeza "Install"' : 'Tap "Install"' %></li>
            <li>5. <%= lang === 'sw' ? 'Fungua programu na uanze kununua!' : 'Open the app and start buying!' %></li>
        </ol>
    </div>
</div>

<%- include('partials/footer') %>