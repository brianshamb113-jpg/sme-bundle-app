<%- include('partials/header') %>

<div class="max-w-6xl mx-auto px-4 py-8">
    <div class="flex justify-between items-center mb-6">
        <h1 class="text-2xl font-bold text-white">🏦 Manage Withdrawals</h1>
        <a href="/admin" class="text-sm text-gray-400 hover:text-white">← Back to Admin</a>
    </div>

    <% if (typeof success !== 'undefined' && success) { %>
        <div class="bg-green-500/20 border border-green-500/30 text-green-300 p-3 rounded-xl mb-4">✅ Action completed!</div>
    <% } %>

    <div class="glass rounded-2xl p-6">
        <div class="overflow-x-auto">
            <table class="w-full text-sm text-left">
                <thead class="border-b border-white/10 text-gray-400">
                    <tr>
                        <th class="pb-3 px-2">Agent</th>
                        <th class="pb-3 px-2">Amount</th>
                        <th class="pb-3 px-2">Payout Number</th>
                        <th class="pb-3 px-2">Status</th>
                        <th class="pb-3 px-2">Actions</th>
                    </tr>
                </thead>
                <tbody>
                    <% withdrawals.forEach(function(w) { %>
                        <tr class="border-b border-white/5">
                            <td class="py-3 px-2 text-white"><%= w.agentName %><br><span class="text-xs text-gray-400"><%= w.agentPhone %></span></td>
                            <td class="py-3 px-2 text-green-400 font-bold">TZS <%= w.amount.toLocaleString() %></td>
                            <td class="py-3 px-2 text-white font-mono"><%= w.payoutNumber %></td>
                            <td class="py-3 px-2">
                                <% if (w.status === 'pending') { %><span class="text-yellow-400">⏳ Pending</span><% } %>
                                <% if (w.status === 'approved') { %><span class="text-green-400">✅ Paid</span><% } %>
                                <% if (w.status === 'rejected') { %><span class="text-red-400">❌ Rejected</span><% } %>
                            </td>
                            <td class="py-3 px-2">
                                <% if (w.status === 'pending') { %>
                                    <form action="/admin/withdrawals/process/<%= w._id %>" method="POST" class="flex gap-2">
                                        <button type="submit" name="action" value="approve" class="px-3 py-1.5 bg-green-600 rounded-lg text-white text-xs font-bold hover:bg-green-700 transition" onclick="return confirm('Umeshatuma pesa kwenye namba hii?')">
                                            Mark as Paid
                                        </button>
                                        <button type="submit" name="action" value="reject" class="px-3 py-1.5 bg-red-600 rounded-lg text-white text-xs font-bold hover:bg-red-700 transition" onclick="return confirm('Rudisha pesa kwenye wallet ya agent?')">
                                            Reject
                                        </button>
                                    </form>
                                <% } else { %>
                                    <span class="text-xs text-gray-500"><%= new Date(w.dateProcessed).toLocaleDateString() %></span>
                                <% } %>
                            </td>
                        </tr>
                    <% }); %>
                </tbody>
            </table>
            <% if (withdrawals.length === 0) { %><p class="text-center text-gray-400 py-6">No withdrawal requests.</p><% } %>
        </div>
    </div>
</div>

<%- include('partials/footer') %>