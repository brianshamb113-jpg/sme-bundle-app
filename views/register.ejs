<%- include('partials/header') %>

<div class="max-w-md mx-auto px-4 py-8">
    <div class="glass rounded-2xl p-8">
        
        <div class="text-center mb-6">
            <span class="text-4xl">📝</span>
            <h2 class="text-2xl font-bold text-white mt-2">
                <%= lang === 'sw' ? 'Jisajili' : 'Create Account' %>
            </h2>
            <p class="text-gray-400 text-sm">
                <%= lang === 'sw' ? 'Jisajili ili kuanza' : 'Sign up to get started' %>
            </p>
        </div>

        <% if (typeof error !== 'undefined' && error) { %>
            <div class="bg-red-500/20 border border-red-500/30 text-red-300 p-3 rounded-xl text-sm mb-4 text-center">
                <%= error %>
            </div>
        <% } %>

        <form action="/register" method="POST">
            <!-- Account Type Selection -->
            <div class="mb-5">
                <label class="block text-white text-sm font-semibold mb-2">
                    <%= lang === 'sw' ? 'Aina ya Akaunti' : 'Account Type' %>
                </label>
                <div class="grid grid-cols-2 gap-2">
                    <label class="glass rounded-xl p-3 text-center cursor-pointer border border-transparent has-[:checked]:border-blue-500 has-[:checked]:bg-blue-500/20 transition">
                        <input type="radio" name="role" value="b2c" class="hidden" checked>
                        <div class="text-2xl mb-1">👤</div>
                        <div class="text-xs font-semibold text-white"><%= lang === 'sw' ? 'Mtu Binafsi' : 'Personal' %></div>
                    </label>
                    <label class="glass rounded-xl p-3 text-center cursor-pointer border border-transparent has-[:checked]:border-purple-500 has-[:checked]:bg-purple-500/20 transition">
                        <input type="radio" name="role" value="b2b_agent" class="hidden">
                        <div class="text-2xl mb-1">🏪</div>
                        <div class="text-xs font-semibold text-white"><%= lang === 'sw' ? 'Wakala (Reseller)' : 'Agent (Reseller)' %></div>
                    </label>
                </div>
            </div>

            <!-- Full Name -->
            <div class="mb-4">
                <label class="block text-white text-sm font-semibold mb-2">
                    <%= lang === 'sw' ? 'Jina Kamili' : 'Full Name' %>
                </label>
                <input type="text" name="fullname" required placeholder="<%= lang === 'sw' ? 'Jina lako kamili' : 'Your full name' %>"
                       class="w-full px-4 py-3 bg-white/10 border border-white/20 rounded-xl text-white placeholder-gray-400 focus:outline-none focus:ring-2 focus:ring-blue-500">
            </div>

            <!-- Referral Code Toggle -->
            <div class="mb-4">
                <label class="flex items-center gap-2 cursor-pointer text-sm text-gray-300">
                    <input type="checkbox" id="toggleRefCode" class="rounded accent-blue-500 w-4 h-4">
                    <%= lang === 'sw' ? 'Nina Kodi ya Rufaa (Hiari)' : 'I have a Referral Code (Optional)' %>
                </label>
                <div id="refCodeContainer" class="mt-2 hidden">
                    <input type="text" name="refCode" id="refCode" placeholder="<%= lang === 'sw' ? 'Mfano: BRI1234' : 'e.g., BRI1234' %>"
                           class="w-full px-4 py-3 bg-white/10 border border-white/20 rounded-xl text-white placeholder-gray-400 focus:outline-none focus:ring-2 focus:ring-blue-500">
                </div>
            </div>

            <!-- Phone Number -->
            <div class="mb-4">
                <label class="block text-white text-sm font-semibold mb-2">
                    <%= lang === 'sw' ? 'Namba ya Simu' : 'Phone Number' %>
                </label>
                <input type="tel" name="phone" required placeholder="0xxxxxxxxx"
                       class="w-full px-4 py-3 bg-white/10 border border-white/20 rounded-xl text-white placeholder-gray-400 focus:outline-none focus:ring-2 focus:ring-blue-500">
            </div>

            <!-- Password -->
            <div class="mb-6">
                <label class="block text-white text-sm font-semibold mb-2">
                    <%= lang === 'sw' ? 'Nenosiri' : 'Password' %>
                </label>
                <input type="password" name="password" required placeholder="<%= lang === 'sw' ? 'Unda nenosiri' : 'Create a password' %>" minlength="6"
                       class="w-full px-4 py-3 bg-white/10 border border-white/20 rounded-xl text-white placeholder-gray-400 focus:outline-none focus:ring-2 focus:ring-blue-500">
            </div>

            <button type="submit" class="w-full py-3 bg-gradient-to-r from-blue-500 to-purple-600 rounded-xl font-semibold text-white hover:scale-105 transition shadow-lg">
                <%= lang === 'sw' ? 'Jisajili' : 'Register' %>
            </button>
        </form>

        <p class="text-center text-gray-400 text-sm mt-4">
            <%= lang === 'sw' ? 'Tayari una akaunti?' : 'Already have an account?' %>
            <a href="/login" class="text-blue-400 font-semibold hover:text-blue-300 transition">
                <%= lang === 'sw' ? 'Ingia' : 'Login' %>
            </a>
        </p>

        <div class="text-center mt-4">
            <a href="/" class="text-sm text-gray-500 hover:text-white transition">
                ← <%= lang === 'sw' ? 'Nyumbani' : 'Home' %>
            </a>
        </div>
    </div>
</div>

<script>
    // Toggle referral code input
    document.getElementById('toggleRefCode').addEventListener('change', function() {
        const container = document.getElementById('refCodeContainer');
        container.classList.toggle('hidden', !this.checked);
    });
</script>

<%- include('partials/footer') %>