<%- include('partials/header') %>

<div class="max-w-2xl mx-auto px-4 py-8">
    <div class="flex justify-between items-center mb-6">
        <h1 class="text-2xl font-bold text-white">🏦 Withdraw Funds</h1>
        <a href="/dashboard" class="text-sm text-gray-400 hover:text-white">← Back to Dashboard</a>
    </div>

    <% if (typeof success !== 'undefined' && success === 'requested') { %>
        <div class="bg-green-500/20 border border-green-500/30 text-green-300 p-3 rounded-xl mb-4">
            ✅ Request submitted! Admin will process it shortly.
        </div>
    <% } %>
    <% if (typeof error !== 'undefined' && error === 'min_amount') { %>
        <div class="bg-red-500/20 border border-red-500/30 text-red-300 p-3 rounded-xl mb-4">
            ❌ Minimum withdrawal is 5,000 TZS.
        </div>
    <% } %>
    <% if (typeof error !== 'undefined' && error === 'insufficient_funds') { %>
        <div class="bg-red-500/20 border border-red-500/30 text-red-300 p-3 rounded-xl mb-4">
            ❌ Insufficient wallet balance.
        </div>
    <% } %>

    <!-- Balance Card -->
    <div class="glass rounded-2xl p-6 mb-6 border-2 border-green-500/30 text-center">
        <div class="text-sm text-gray-400 mb-1">Available Balance</div>
        <div class="text-4xl font-bold text-white mb-4">TZS <%= dbUser.walletBalance.toLocaleString() %></div>
        
        <form action="/agent/withdraw" method="POST">
            <div class="mb-4 text-left">
                <label class="block text-white text-sm font-semibold mb-2">Amount to Withdraw (TZS)</label>
                <input type="number" name="amount" required min="5000" max="<%= dbUser.walletBalance %>"
                       class="w-full px-4 py-3 bg-white/10 border border-white/20 rounded-xl text-white placeholder-gray-400 focus:outline-none focus:ring-2 focus:ring-green-500">
            </div>
            <div class="mb-4 text-left">
                <label class="block text-white text-sm font-semibold mb-2">Your Mobile Money Number (Payout)</label>
                <input type="tel" name="payoutNumber" required placeholder="0712345678"
                       class="w-full px-4 py-3 bg-white/10 border border-white/20 rounded-xl text-white placeholder-gray-400 focus:outline-none focus:ring-2 focus:ring-green-500">
            </div>
            <button type="submit" class="w-full py-3 bg-gradient-to-r from-green-500 to-emerald-600 rounded-xl font-bold text-white hover:scale-105 transition shadow-lg">
                Request Withdrawal
            </button>
        </form>
    </div>

    <!-- History -->
    <div class="glass rounded-2xl p-6">
        <h2 class="text-lg font-bold text-white mb-4">Withdrawal History</h2>
        <% if (history.length === 0) { %>
            <p class="text-gray-400 text-sm text-center">No withdrawal requests yet.</p>
        <% } else { %>
            <div class="space-y-2">
                <% history.forEach(function(w) { %>
                    <div class="flex justify-between items-center bg-white/5 p-3 rounded-xl border border-white/10">
                        <div>
                            <div class="text-white font-bold">TZS <%= w.amount.toLocaleString() %></div>
                            <div class="text-xs text-gray-400">To: <%= w.payoutNumber %></div>
                            <div class="text-xs text-gray-500"><%= new Date(w.dateRequested).toLocaleDateString() %></div>
                        </div>
                        <div>
                            <% if (w.status === 'pending') { %>
                                <span class="px-2 py-1 bg-yellow-500/20 text-yellow-400 rounded-lg text-xs font-semibold">⏳ Pending</span>
                            <% } else if (w.status === 'approved') { %>
                                <span class="px-2 py-1 bg-green-500/20 text-green-400 rounded-lg text-xs font-semibold">✅ Paid</span>
                            <% } else { %>
                                <span class="px-2 py-1 bg-red-500/20 text-red-400 rounded-lg text-xs font-semibold">❌ Rejected</span>
                            <% } %>
                        </div>
                    </div>
                <% }); %>
            </div>
        <% } %>
    </div>
</div>

<%- include('partials/footer') %>