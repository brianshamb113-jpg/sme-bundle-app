<%- include('partials/header') %>

<div class="max-w-4xl mx-auto px-4 py-8">
    <h1 class="text-2xl font-bold text-white mb-6">
        📊 <%= lang === 'sw' ? 'Historia ya Manunuzi' : 'Transaction History' %>
    </h1>

    <% 
        const totalSpent = transactions.reduce((sum, t) => sum + (t.status === 'completed' ? t.amount : 0), 0);
        const completedTransactions = transactions.filter(t => t.status === 'completed').length;
    %>

    <div class="grid grid-cols-3 gap-3 mb-6">
        <div class="glass rounded-xl p-4 text-center">
            <div class="text-2xl font-bold text-white"><%= transactions.length %></div>
            <div class="text-xs text-gray-400"><%= lang === 'sw' ? 'Manunuzi Yote' : 'Total' %></div>
        </div>
        <div class="glass rounded-xl p-4 text-center">
            <div class="text-2xl font-bold text-green-400"><%= completedTransactions %></div>
            <div class="text-xs text-gray-400"><%= lang === 'sw' ? 'Yaliyokamilika' : 'Completed' %></div>
        </div>
        <div class="glass rounded-xl p-4 text-center">
            <div class="text-2xl font-bold text-blue-400"><%= totalSpent.toLocaleString() %></div>
            <div class="text-xs text-gray-400">TZS <%= lang === 'sw' ? 'Zilizotumika' : 'Spent' %></div>
        </div>
    </div>

    <div class="glass rounded-2xl p-6">
        <h2 class="text-lg font-bold text-white mb-4">
            <%= lang === 'sw' ? 'Manunuzi ya Hivi Karibuni' : 'Recent Transactions' %>
        </h2>

        <% if (transactions.length === 0) { %>
            <div class="text-center py-12">
                <div class="text-6xl mb-4">📭</div>
                <p class="text-gray-400 mb-4">
                    <%= lang === 'sw' ? 'Hakuna manunuzi bado' : 'No transactions yet' %>
                </p>
                <a href="/dashboard" class="inline-block px-6 py-3 bg-gradient-to-r from-blue-500 to-purple-600 rounded-xl text-white font-semibold hover:scale-105 transition">
                    <%= lang === 'sw' ? 'Anza Kununua' : 'Start Buying Now' %>
                </a>
            </div>
        <% } else { %>
            <% transactions.forEach(function(t) { %>
                <div class="border-b border-white/10 py-4 flex justify-between items-center">
                    <div>
                        <div class="text-white font-semibold"><%= t.bundleName %></div>
                        <div class="text-xs text-gray-400 mt-1">
                            <%= new Date(t.date).toLocaleString('en-TZ') %> · <%= t.paymentMethod %>
                        </div>
                        <div class="text-xs text-gray-500 mt-1">ID: <%= t.id %></div>
                    </div>
                    <div class="text-right">
                        <div class="text-green-400 font-bold">TZS <%= t.amount.toLocaleString() %></div>
                        <div class="text-xs mt-1">
                            <% if (t.status === 'completed') { %>
                                <span class="bg-green-500/20 text-green-300 px-2 py-1 rounded-full">✅ <%= lang === 'sw' ? 'Imekamilika' : 'Completed' %></span>
                            <% } else { %>
                                <span class="bg-yellow-500/20 text-yellow-300 px-2 py-1 rounded-full">⏳ <%= t.status %></span>
                            <% } %>
                        </div>
                    </div>
                </div>
            <% }); %>
        <% } %>
    </div>

    <div class="text-center mt-6">
        <a href="/dashboard" class="text-sm text-gray-400 hover:text-white transition">
            ← <%= lang === 'sw' ? 'Rudi Dashibodi' : 'Back to Dashboard' %>
        </a>
    </div>
</div>

<%- include('partials/footer') %>